Project DT_ERD {
  database_type: 'PostgreSQL'
  Note: 'Physical Relational and Data Dictionary (Auto-generado desde Markdown)'
}

TableGroup tax {
  "tax"."equipment_classes"
  "tax"."equipment_units"
  "tax"."functional_locations"
  "tax"."maintainable_items"
  "tax"."subunits"
}

TableGroup mtto {
  "mtto"."backlog_items"
  "mtto"."failure_records"
  "mtto"."maintenance_plans"
  "mtto"."media_attachments"
  "mtto"."work_order_histories"
  "mtto"."work_orders"
  "mtto"."work_requests"
}

TableGroup inv {
  "inv"."inventory_transactions"
  "inv"."maintainable_item_spare_parts"
  "inv"."material_requirements"
  "inv"."spare_parts"
  "inv"."suppliers"
  "inv"."warehouses"
}

TableGroup vis {
  "vis"."isolation_points"
  "vis"."mesh_mappings"
  "vis"."spatial_metadata"
  "vis"."telemetry_signals"
  "vis"."visual_layers"
  "vis"."work_order_isolations"
  "vis"."work_permits"
}

TableGroup adm {
  "adm"."audit_logs"
  "adm"."auth_tokens"
  "adm"."role_permissions"
  "adm"."roles"
  "adm"."user_roles"
  "adm"."users"
  "adm"."work_order_assignments"
}

Table "tax"."equipment_classes" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "class_name" "VARCHAR(120)" [unique, not null, note: 'Master data at the class level.']
  "description" "VARCHAR(255)" [note: 'Class description.']
  "manufacturer_standard" "VARCHAR(120)" [note: 'Standardization reference.']
}

Table "tax"."equipment_units" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "serial_number" "VARCHAR(100)" [unique, not null, note: 'Asset identification integrity.']
  "manufacturer" "VARCHAR(120)" [not null, note: 'Asset provenance.']
  "model" "VARCHAR(120)" [not null, note: 'Asset type identification.']
  "purchase_date" "DATE" [not null, note: 'Procurement chronology.']
  "rejection_reason" "VARCHAR(255)" [note: 'Only present when commissioning is rejected.']
  "boundary_start" "VARCHAR(150)" [not null, note: 'Starting point of the boundary definition.']
  "boundary_end" "VARCHAR(150)" [not null, note: 'Ending point of the boundary definition.']
  "acquisition_date" "DATE" [not null, note: 'Asset acquisition traceability.']
  "installation_date" "DATE" [note: 'Installation may be pending.']
  "operation_start_date" "DATE" [note: 'Operational start may be pending.']
  "operating_hours" "BIGINT" [not null, default: 0, note: 'Reliability and usage tracking.']
  "surveillance_hours" "BIGINT" [not null, default: 0, note: 'Surveillance/standby time for accurate failure calculation (ISO 14224).']
  "disposal_date" "DATE" [note: 'End-of-life record for liability traceability (ISO 55000).']
  "disposal_reason" "VARCHAR(255)" [note: 'Reason for asset retirement or decommissioning.']
  "operational_status" "VARCHAR(20)" [not null, note: 'Controlled operational status vocabulary.']
  "lifecycle_status" "VARCHAR(20)" [not null, note: 'Controlled lifecycle vocabulary.']
  "maintenance_status" "VARCHAR(30)" [not null, note: 'Controlled maintenance status vocabulary.']
  "health_status" "VARCHAR(30)" [note: 'Controlled overall health status vocabulary (ISO 13374-4).']
  "is_sce" "BOOLEAN" [not null, default: false, note: 'Safety Critical Element indicator.']
  "functional_location_id" "UUID" [unique, note: 'Foreign key to the related table.']
  "equipment_class_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "warehouse_id" "UUID" [note: 'Foreign key to the related table.']
}

Table "tax"."functional_locations" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "tag_number" "VARCHAR(50)" [unique, not null, note: 'ISO 14224 tag identity and location traceability.']
  "name" "VARCHAR(150)" [not null, note: 'Human-readable location name.']
  "description" "VARCHAR(255)" [note: 'Optional explanatory text.']
  "criticality" "VARCHAR(30)" [not null, note: 'Controlled priority vocabulary.']
  "geographic_location" "VARCHAR(150)" [note: 'Physical context of the location.']
  "environmental_exposure" "VARCHAR(150)" [note: 'Environmental conditions for reliability calculations (ISO 14224).']
  "hierarchy_level" "SMALLINT" [not null, note: 'Levels 1 to 5 of the ISO 14224 taxonomy (Functional Locations govern the plant\'s spatial structure down to the process, while L6 to L8 correspond to physical equipment and components).']
  "parent_id" "UUID" [note: 'Foreign key to the related table.']
}

Table "tax"."maintainable_items" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "subunit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "component_name" "VARCHAR(120)" [not null, note: 'Identity of the maintainable item.']
  "subunit_type" "VARCHAR(80)" [not null, note: 'Taxonomic classification.']
  "spare_part_type" "VARCHAR(80)" [note: 'Optional spare parts correspondence.']
  "design_attributes" "JSONB" [note: 'Structured static design properties (ISO 14224 Annex A).']
  "status" "VARCHAR(30)" [not null, note: 'Item\'s lifecycle status.']
}

Table "tax"."subunits" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "subunit_type" "VARCHAR(80)" [not null, note: 'Subcomponent taxonomy.']
  "name" "VARCHAR(120)" [not null, note: 'Subcomponent label.']
}

Table "mtto"."backlog_items" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "work_request_id" "UUID" [unique, not null, note: 'Foreign key to the related table.']
  "priority_score" "INT" [not null, note: 'Backlog score derived from RIME (Calculated).']
  "status" "VARCHAR(20)" [not null, note: 'Backlog lifecycle status (prioritization).']
}

Table "mtto"."failure_records" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identity of the failure event.']
  "work_order_id" "UUID" [unique, not null, note: 'Foreign key to the related table.']
  "maintainable_item_id" "UUID" [note: 'Foreign key to the related table.']
  "failure_mode" "VARCHAR(120)" [not null, note: 'ISO 14224 failure coding.']
  "failure_mechanism" "VARCHAR(120)" [not null, note: 'ISO 14224 failure coding.']
  "failure_cause" "VARCHAR(120)" [not null, note: 'ISO 14224 failure coding.']
  "detection_method" "VARCHAR(120)" [not null, note: 'Failure detection method (ISO 14224).']
  "operational_condition" "VARCHAR(120)" [not null, note: 'Operational condition at the time of failure (ISO 14224).']
  "operational_impact" "VARCHAR(120)" [not null, note: 'Operational impact of the failure (ISO 14224).']
  "downtime" "DECIMAL(10,2)" [not null, note: 'Reliability analysis metric (Calculated).']
  "status" "VARCHAR(20)" [not null, note: 'Status of the failure record.']
}

Table "mtto"."maintenance_plans" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "maintenance_method" "VARCHAR(80)" [not null, note: 'Maintenance strategy (PM, PdM, CBM).']
  "frequency" "VARCHAR(50)" [not null, note: 'Human-readable frequency description.']
  "frequency_type" "VARCHAR(20)" [not null, note: 'Controlled cadence of the plan.']
  "next_work_order_date" "DATE" [note: 'Scheduled execution date (Calculated).']
  "interval_value" "DECIMAL(12,2)" [note: 'Numeric value of the interval for telemetry (e.g., 500 hours).']
  "next_trigger_limit" "DECIMAL(12,2)" [note: 'Accumulated limit calculated for the next trigger.']
  "estimated_labor_hours" "DECIMAL(10,2)" [not null, note: 'Estimated Man-Hours (Wrench Time) for planning.']
  "required_specialty" "VARCHAR(80)" [not null, note: 'Required technical specialty (e.g., Mechanical, Electrical).']
  "technical_description" "VARCHAR(255)" [not null, note: 'Technical description of the task scope.']
  "status" "VARCHAR(20)" [not null, note: 'Plan (document) lifecycle status.']
}

Table "mtto"."media_attachments" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "work_order_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "file_url" "VARCHAR(255)" [not null, note: 'Evidence location.']
  "file_type" "VARCHAR(20)" [not null, note: 'Controlled attachment file format.']
  "uploaded_at" "TIMESTAMP" [not null, note: 'Upload/ingestion time of the evidence.']
}

Table "mtto"."work_order_histories" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "work_order_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "old_status" "VARCHAR(20)" [note: 'Previous lifecycle status (NULL if first status).']
  "new_status" "VARCHAR(20)" [not null, note: 'New lifecycle status.']
  "timestamp" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Transition time.']
  "duration_seconds" "BIGINT" [note: 'Time spent in the state (Calculated upon transition).']
}

Table "mtto"."work_orders" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "maintenance_plan_id" "UUID" [note: 'Foreign key to the related table.']
  "work_request_id" "UUID" [unique, note: 'Foreign key to the related table.']
  "work_permit_id" "UUID" [note: 'Foreign key to the related table.']
  "current_status" "VARCHAR(20)" [not null, note: 'Execution lifecycle status (FSM).']
  "maintenance_method" "VARCHAR(80)" [not null, note: 'Maintenance method (Corrective, Preventive, etc.).']
  "creation_date" "TIMESTAMP" [not null, note: 'Timestamp of order creation.']
  "scheduled_date" "TIMESTAMP" [note: 'Planned start.']
  "actual_start" "TIMESTAMP" [note: 'Actual execution start.']
  "actual_finish" "TIMESTAMP" [note: 'Actual execution finish.']
  "actual_labor_hours" "DECIMAL(10,2)" [note: 'Actual labor duration (Calculated).']
  "criticality" "VARCHAR(20)" [not null, note: 'WO criticality / priority label.']
}

Table "mtto"."work_requests" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "description" "VARCHAR(255)" [not null, note: 'Request narrative.']
  "priority" "VARCHAR(20)" [not null, note: 'Request priority label.']
  "request_date" "TIMESTAMP" [not null, note: 'Timeline for audit.']
  "request_source" "VARCHAR(80)" [not null, note: 'Origin of the request.']
  "status" "VARCHAR(20)" [not null, note: 'Request lifecycle status.']
  "work_class_code" "SMALLINT" [not null, note: 'Numeric weight of the selected work class for RIME.']
}

Table "inv"."inventory_transactions" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "spare_part_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "warehouse_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "work_order_id" "UUID" [note: 'Foreign key to the related table.']
  "quantity" "DECIMAL(12,4)" [not null, default: 1, note: 'Transacted quantity (positive for receipts, negative for issues).']
  "transaction_type" "VARCHAR(20)" [not null, note: 'Movement type (RECEIPT, ISSUE, ADJUSTMENT).']
  "timestamp" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Precise temporal record of the movement.']
  "reason" "VARCHAR(255)" [not null, note: 'Reason for movement or reference to external documents.']
  "total_cost" "DECIMAL(12,2)" [not null, note: 'Total cost of the transaction (Quantity \* Cost).']
  "aisle_shelf_location" "VARCHAR(150)" [note: 'Specific physical location of the transaction (aisle/shelf).']
  "serial_number" "VARCHAR(100)" [note: 'Serial number or Tag of the rotating equipment (Asset Swap).']
}

Table "inv"."maintainable_item_spare_parts" {
  "maintainable_item_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "spare_part_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
}

Table "inv"."material_requirements" {
  "work_order_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "spare_part_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "planned_quantity" "DECIMAL(12,4)" [not null, default: 1, note: 'Planned spare parts before WO execution.']
  "actual_quantity" "DECIMAL(12,4)" [note: 'Spare parts actually consumed during WO execution.']
  "is_reserved" "BOOLEAN" [not null, note: 'Flag indicating if stock was already set aside in warehouse.']
}

Table "inv"."spare_parts" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "sku" "VARCHAR(80)" [unique, not null, note: 'Part identity.']
  "description" "VARCHAR(255)" [not null, note: 'Human-readable part description.']
  "manufacturer" "VARCHAR(120)" [not null, note: 'Supplier/manufacturer identity.']
  "commodity_code" "VARCHAR(80)" [note: 'Classification code.']
  "reorder_point" "DECIMAL(12,4)" [not null, note: 'Minimum purchase activation threshold.']
  "unit_of_measure" "VARCHAR(20)" [not null, note: 'Standard Unit of Measure (UoM).']
  "stock_policy" "VARCHAR(20)" [not null, note: 'Replenishment policy (Min/Max, Reorder Point, JIT).']
  "is_rebuildable" "BOOLEAN" [not null, default: false, note: 'Indicates whether the part is discarded or sent to the workshop for repair.']
  "quantity_on_hand" "DECIMAL(12,4)" [not null, note: 'Quantity currently in physical inventory.']
  "reserved_quantity" "DECIMAL(12,4)" [not null, note: 'Committed stock for planned orders.']
  "max_capacity" "DECIMAL(12,4)" [not null, note: 'Physical warehouse limit for the part.']
  "unit_cost" "DECIMAL(12,2)" [not null, note: 'Standard unit acquisition cost.']
  "status" "VARCHAR(20)" [not null, note: 'Spare part availability status.']
  "supplier_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "equipment_class_id" "UUID" [note: 'Foreign key to the related table.']
}

Table "inv"."suppliers" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "name" "VARCHAR(120)" [not null, note: 'Supplier commercial identity.']
  "contact_info" "VARCHAR(255)" [not null, note: 'Phone, email, or contact address.']
  "warranty_terms" "VARCHAR(255)" [not null, note: 'Standard commercial warranty terms.']
}

Table "inv"."warehouses" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "name" "VARCHAR(80)" [not null, note: 'Warehouse identity.']
  "location" "VARCHAR(255)" [not null, note: 'Warehouse address or physical location.']
  "capacity" "DECIMAL(12,4)" [not null, note: 'Maximum volumetric or load capacity of the warehouse.']
}

Table "vis"."isolation_points" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "isolation_tag" "VARCHAR(80)" [unique, not null, note: 'Identity of the isolation point.']
  "isolation_type" "VARCHAR(20)" [not null, note: 'Isolation vocabulary.']
  "is_verified" "BOOLEAN" [not null, default: false, note: 'Verification status.']
}

Table "vis"."mesh_mappings" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [unique, not null, note: 'Foreign key to the related table.']
  "mesh_uuid" "VARCHAR(80)" [unique, not null, note: 'Identity or path of the asset\'s 3D model.']
  "mapping_status" "VARCHAR(20)" [not null, note: 'Digital twin mapping status.']
  "last_sync_time" "TIMESTAMP" [note: 'Last synchronization time.']
}

Table "vis"."spatial_metadata" {
  "mesh_mapping_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "position" "JSONB" [not null, note: 'Spatial vector coordinate (e.g., x,y,z).']
  "rotation" "JSONB" [note: 'Orientation descriptor (e.g., quaternion).']
  "scale" "JSONB" [note: 'Scale descriptor.']
}

Table "vis"."telemetry_signals" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "signal_type" "VARCHAR(80)" [not null, note: 'Sensor signal label.']
  "value" "DECIMAL(18,6)" [not null, note: 'Raw measurement value.']
  "unit" "VARCHAR(20)" [not null, note: 'Measurement unit.']
  "threshold" "DECIMAL(18,6)" [note: 'Alert threshold.']
  "timestamp" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Measurement time.']
  "is_safety_critical" "BOOLEAN" [not null, note: 'Safety classification flag.']
}

Table "vis"."visual_layers" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "work_order_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "layer_type" "VARCHAR(80)" [not null, note: 'Visual representation type.']
  "opacity_level" "DECIMAL(5,2)" [not null, note: 'Rendering control.']
  "status" "VARCHAR(20)" [not null, note: 'Visual layer status.']
}

Table "vis"."work_order_isolations" {
  "work_order_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "isolation_point_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "is_isolated" "BOOLEAN" [not null, default: false, note: 'Verified lockout state for the specific work.']
  "isolated_at" "TIMESTAMP" [note: 'Timestamp when the lockout was executed.']
  "padlock_tag_id" "VARCHAR(80)" [note: 'Identifier of the physical padlock or tag (Try-Out).']
}

Table "vis"."work_permits" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "permit_identifier" "VARCHAR(80)" [unique, not null, note: 'Permit traceability.']
  "valid_from" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Timeline start.']
  "valid_to" "TIMESTAMP" [not null, note: 'Timeline end.']
  "status" "VARCHAR(20)" [not null, note: 'Permit status (Active, Revoked, Expired).']
}

Table "adm"."audit_logs" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "user_id" "UUID" [note: 'Foreign key to the related table.']
  "event_type" "VARCHAR(80)" [not null, note: 'Action executed (e.g., CREATE, UPDATE, DELETE).']
  "entity_type" "VARCHAR(80)" [not null, note: 'Affected table or domain entity.']
  "entity_id" "UUID" [not null, note: 'Identifier of the affected record.']
  "timestamp" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Exact moment of the mutation.']
  "previous_state" "JSONB" [note: 'Snapshot of the data before the change.']
  "new_state" "JSONB" [note: 'Snapshot of the data after the change.']
  "ip_address" "VARCHAR(45)" [note: 'Network traceability (IPv4 or IPv6).']
  "user_agent" "VARCHAR(255)" [note: 'Client traceability.']
  "integrity_hash" "VARCHAR(255)" [not null, note: 'Cryptographic hash for immutability verification.']
}

Table "adm"."auth_tokens" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "user_id" "UUID" [not null, note: 'Foreign key to the related table.']
  "token_hash" "VARCHAR(255)" [unique, not null, note: 'Cryptographic representation of the token.']
  "expires_at" "TIMESTAMP" [not null, note: 'Temporal validity limit.']
  "is_revoked" "BOOLEAN" [not null, default: false, note: 'Pre-expiration manual revocation flag.']
  "purpose" "VARCHAR(20)" [not null, note: 'Context of use (e.g., ACCESS, REFRESH, RESET).']
}

Table "adm"."role_permissions" {
  "role_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "module" "VARCHAR(80)" [pk, not null, note: 'Application subdomain or module.']
  "action" "VARCHAR(80)" [pk, not null, note: 'Granted behavior (e.g., READ, WRITE, APPROVE).']
}

Table "adm"."roles" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "name" "VARCHAR(80)" [unique, not null, note: 'Human-readable role identity.']
  "description" "VARCHAR(255)" [note: 'Description of the RBAC role.']
}

Table "adm"."user_roles" {
  "user_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "role_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
}

Table "adm"."users" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Unique identifier of the entity (PK).']
  "username" "VARCHAR(80)" [unique, not null, note: 'Access identity.']
  "email" "VARCHAR(120)" [unique, not null, note: 'Communication identity.']
  "password_hash" "VARCHAR(255)" [not null, note: 'Secure credential.']
  "full_name" "VARCHAR(150)" [not null, note: 'Real identity.']
  "is_active" "BOOLEAN" [not null, default: true, note: 'Access control flag.']
  "failed_login_attempts" "INT" [not null, default: 0, note: 'Brute force defense counter.']
  "lockout_until" "TIMESTAMP" [note: 'Temporary block time window.']
  "last_login_at" "TIMESTAMP" [note: 'Activity traceability.']
}

Table "adm"."work_order_assignments" {
  "work_order_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "user_id" "UUID" [pk, not null, note: 'Foreign key to the related table.']
  "assigned_role" "VARCHAR(80)" [not null, note: 'Operational role of the technician in the specific WO.']
  "assigned_at" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Moment of assignment.']
}

// --- RELACIONES ---
Ref: "tax"."equipment_classes"."id" < "tax"."equipment_units"."equipment_class_id" [delete: restrict, update: cascade]
Ref: "tax"."functional_locations"."id" < "tax"."functional_locations"."parent_id" [delete: restrict, update: cascade]
Ref: "tax"."functional_locations"."id" < "tax"."equipment_units"."functional_location_id" [delete: restrict, update: cascade]
Ref: "tax"."equipment_units"."id" < "tax"."subunits"."equipment_unit_id" [delete: cascade, update: cascade]
Ref: "tax"."subunits"."id" < "tax"."maintainable_items"."subunit_id" [delete: cascade, update: cascade]
Ref: "tax"."equipment_units"."id" < "mtto"."maintenance_plans"."equipment_unit_id" [delete: cascade, update: cascade]
Ref: "tax"."equipment_units"."id" < "mtto"."work_orders"."equipment_unit_id" [delete: cascade, update: cascade]
Ref: "mtto"."maintenance_plans"."id" < "mtto"."work_orders"."maintenance_plan_id" [delete: set null, update: cascade]
Ref: "tax"."equipment_units"."id" < "mtto"."work_requests"."equipment_unit_id" [delete: cascade, update: cascade]
