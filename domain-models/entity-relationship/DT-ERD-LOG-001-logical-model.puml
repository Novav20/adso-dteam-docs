@startuml LogicalModel
!include theme.puml

package "Taxonomía de Activos (ISO 14224)" as tax_module {
    entity "equipment_classes" as equipment_classes {
        * id : UUID <<pk>>
        * class_name : VARCHAR(120) <<unique>>
        description : VARCHAR(255)
        manufacturer_standard : VARCHAR(120)
    }

    entity "equipment_units" as equipment_units {
        * id : UUID <<pk>>
        * serial_number : VARCHAR(100) <<unique>>
        * manufacturer : VARCHAR(120)
        * model : VARCHAR(120)
        * purchase_date : DATE
        rejection_reason : VARCHAR(255)
        * boundary_start : VARCHAR(150)
        * boundary_end : VARCHAR(150)
        * acquisition_date : DATE
        installation_date : DATE
        operation_start_date : DATE
        * operating_hours : BIGINT
        * surveillance_hours : BIGINT
        disposal_date : DATE
        disposal_reason : VARCHAR(255)
        * operational_status : VARCHAR(20)
        * lifecycle_status : VARCHAR(20)
        * maintenance_status : VARCHAR(30)
        health_status : VARCHAR(30)
        * is_sce : BOOLEAN
        functional_location_id : UUID <<fk, unique>>
        * equipment_class_id : UUID <<fk>>
        warehouse_id : UUID <<fk>>
    }

    entity "functional_locations" as functional_locations {
        * id : UUID <<pk>>
        * tag_number : VARCHAR(50) <<unique>>
        * name : VARCHAR(150)
        description : VARCHAR(255)
        * criticality : VARCHAR(30)
        geographic_location : VARCHAR(150)
        environmental_exposure : VARCHAR(150)
        * hierarchy_level : SMALLINT
        parent_id : UUID <<fk>>
    }

    entity "maintainable_items" as maintainable_items {
        * id : UUID <<pk>>
        * subunit_id : UUID <<fk>>
        * component_name : VARCHAR(120)
        * subunit_type : VARCHAR(80)
        spare_part_type : VARCHAR(80)
        design_attributes : JSONB
        * status : VARCHAR(30)
    }

    entity "subunits" as subunits {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk>>
        * subunit_type : VARCHAR(80)
        * name : VARCHAR(120)
    }

}

package "Operaciones de Mantenimiento (MTTO)" as mtto_module {
    entity "backlog_items" as backlog_items {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk>>
        * work_request_id : UUID <<fk, unique>>
        * priority_score : INT
        * status : VARCHAR(20)
    }

    entity "failure_records" as failure_records {
        * id : UUID <<pk>>
        * work_order_id : UUID <<fk, unique>>
        maintainable_item_id : UUID <<fk>>
        * failure_mode : VARCHAR(120)
        * failure_mechanism : VARCHAR(120)
        * failure_cause : VARCHAR(120)
        * detection_method : VARCHAR(120)
        * operational_condition : VARCHAR(120)
        * operational_impact : VARCHAR(120)
        * downtime : DECIMAL(10,2)
        * status : VARCHAR(20)
    }

    entity "maintenance_plans" as maintenance_plans {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk>>
        * maintenance_method : VARCHAR(80)
        * frequency : VARCHAR(50)
        * frequency_type : VARCHAR(20)
        next_work_order_date : DATE
        interval_value : DECIMAL(12,2)
        next_trigger_limit : DECIMAL(12,2)
        * estimated_labor_hours : DECIMAL(10,2)
        * required_specialty : VARCHAR(80)
        * technical_description : VARCHAR(255)
        * status : VARCHAR(20)
    }

    entity "media_attachments" as media_attachments {
        * id : UUID <<pk>>
        * work_order_id : UUID <<fk>>
        * file_url : VARCHAR(255)
        * file_type : VARCHAR(20)
        * uploaded_at : TIMESTAMP
    }

    entity "work_order_histories" as work_order_histories {
        * id : UUID <<pk>>
        * work_order_id : UUID <<fk>>
        old_status : VARCHAR(20)
        * new_status : VARCHAR(20)
        * timestamp : TIMESTAMP
        duration_seconds : BIGINT
    }

    entity "work_orders" as work_orders {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk>>
        maintenance_plan_id : UUID <<fk>>
        work_request_id : UUID <<fk, unique>>
        work_permit_id : UUID <<fk>>
        * current_status : VARCHAR(20)
        * maintenance_method : VARCHAR(80)
        * creation_date : TIMESTAMP
        scheduled_date : TIMESTAMP
        actual_start : TIMESTAMP
        actual_finish : TIMESTAMP
        actual_labor_hours : DECIMAL(10,2)
        * criticality : VARCHAR(20)
    }

    entity "work_requests" as work_requests {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk>>
        * description : VARCHAR(255)
        * priority : VARCHAR(20)
        * request_date : TIMESTAMP
        * request_source : VARCHAR(80)
        * status : VARCHAR(20)
        * work_class_code : SMALLINT
    }

}

package "Control de Recursos (INV)" as inv_module {
    entity "inventory_transactions" as inventory_transactions {
        * id : UUID <<pk>>
        * spare_part_id : UUID <<fk>>
        * warehouse_id : UUID <<fk>>
        work_order_id : UUID <<fk>>
        * quantity : DECIMAL(12,4)
        * transaction_type : VARCHAR(20)
        * timestamp : TIMESTAMP
        * reason : VARCHAR(255)
        * total_cost : DECIMAL(12,2)
        aisle_shelf_location : VARCHAR(150)
        serial_number : VARCHAR(100)
    }

    entity "maintainable_item_spare_parts" as maintainable_item_spare_parts {
        * maintainable_item_id : UUID <<pk, fk>>
        * spare_part_id : UUID <<pk, fk>>
    }

    entity "material_requirements" as material_requirements {
        * work_order_id : UUID <<pk, fk>>
        * spare_part_id : UUID <<pk, fk>>
        * planned_quantity : DECIMAL(12,4)
        actual_quantity : DECIMAL(12,4)
        * is_reserved : BOOLEAN
    }

    entity "spare_parts" as spare_parts {
        * id : UUID <<pk>>
        * sku : VARCHAR(80) <<unique>>
        * description : VARCHAR(255)
        * manufacturer : VARCHAR(120)
        commodity_code : VARCHAR(80)
        * reorder_point : DECIMAL(12,4)
        * unit_of_measure : VARCHAR(20)
        * stock_policy : VARCHAR(20)
        * is_rebuildable : BOOLEAN
        * quantity_on_hand : DECIMAL(12,4)
        * reserved_quantity : DECIMAL(12,4)
        * max_capacity : DECIMAL(12,4)
        * unit_cost : DECIMAL(12,2)
        * status : VARCHAR(20)
        * supplier_id : UUID <<fk>>
        equipment_class_id : UUID <<fk>>
    }

    entity "suppliers" as suppliers {
        * id : UUID <<pk>>
        * name : VARCHAR(120)
        * contact_info : VARCHAR(255)
        * warranty_terms : VARCHAR(255)
    }

    entity "warehouses" as warehouses {
        * id : UUID <<pk>>
        * name : VARCHAR(80)
        * location : VARCHAR(255)
        * capacity : DECIMAL(12,4)
    }

}

package "Convergencia Gemelo Digital (VIS)" as vis_module {
    entity "isolation_points" as isolation_points {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk>>
        * isolation_tag : VARCHAR(80) <<unique>>
        * isolation_type : VARCHAR(20)
        * is_verified : BOOLEAN
    }

    entity "mesh_mappings" as mesh_mappings {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk, unique>>
        * mesh_uuid : VARCHAR(80) <<unique>>
        * mapping_status : VARCHAR(20)
        last_sync_time : TIMESTAMP
    }

    entity "spatial_metadata" as spatial_metadata {
        * mesh_mapping_id : UUID <<pk, fk>>
        * position : JSONB
        rotation : JSONB
        scale : JSONB
    }

    entity "telemetry_signals" as telemetry_signals {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk>>
        * signal_type : VARCHAR(80)
        * value : DECIMAL(18,6)
        * unit : VARCHAR(20)
        threshold : DECIMAL(18,6)
        * timestamp : TIMESTAMP
        * is_safety_critical : BOOLEAN
    }

    entity "visual_layers" as visual_layers {
        * id : UUID <<pk>>
        * work_order_id : UUID <<fk>>
        * layer_type : VARCHAR(80)
        * opacity_level : DECIMAL(5,2)
        * status : VARCHAR(20)
    }

    entity "work_order_isolations" as work_order_isolations {
        * work_order_id : UUID <<pk, fk>>
        * isolation_point_id : UUID <<pk, fk>>
        * is_isolated : BOOLEAN
        isolated_at : TIMESTAMP
        padlock_tag_id : VARCHAR(80)
    }

    entity "work_permits" as work_permits {
        * id : UUID <<pk>>
        * equipment_unit_id : UUID <<fk>>
        * permit_identifier : VARCHAR(80) <<unique>>
        * permit_type : VARCHAR(30)
        * contractor_name : VARCHAR(150)
        * status : VARCHAR(20)
    }

}

package "Seguridad y Gobernanza (ADM)" as adm_module {
    entity "audit_logs" as audit_logs {
        * id : UUID <<pk>>
        user_id : UUID <<fk>>
        * entity_type : VARCHAR(80)
        * entity_identifier : VARCHAR(80)
        * action_type : VARCHAR(20)
        * timestamp : TIMESTAMP
        previous_state : JSONB
        new_state : JSONB
        * integrity_hash : VARCHAR(255)
    }

    entity "auth_tokens" as auth_tokens {
        * id : UUID <<pk>>
        * user_id : UUID <<fk>>
        * token_hash : VARCHAR(255) <<unique>>
        * expires_at : TIMESTAMP
        * is_used : BOOLEAN
        ip_address : VARCHAR(45)
        user_agent : VARCHAR(255)
    }

    entity "role_permissions" as role_permissions {
        * id : UUID <<pk>>
        * role_id : UUID <<fk>>
        * module : VARCHAR(80)
        * action : VARCHAR(80)
    }

    entity "roles" as roles {
        * id : UUID <<pk>>
        * role_name : VARCHAR(80) <<unique>>
        description : VARCHAR(255)
        * is_system_role : BOOLEAN
    }

    entity "user_roles" as user_roles {
        * user_id : UUID <<pk, fk>>
        * role_id : UUID <<pk, fk>>
    }

    entity "users" as users {
        * id : UUID <<pk>>
        * username : VARCHAR(80) <<unique>>
        * full_name : VARCHAR(150)
        * email : VARCHAR(150) <<unique>>
        * status : VARCHAR(20)
        * password_hash : VARCHAR(255)
        * failed_login_attempts : INT
        lockout_until : TIMESTAMP
        * mfa_enabled : BOOLEAN
        totp_secret : VARCHAR(255)
        deactivation_reason : VARCHAR(255)
    }

    entity "work_order_assignments" as work_order_assignments {
        * id : UUID <<pk>>
        * work_order_id : UUID <<fk>>
        * user_id : UUID <<fk>>
        * role_in_work : VARCHAR(50)
        * assigned_at : TIMESTAMP
    }

}

