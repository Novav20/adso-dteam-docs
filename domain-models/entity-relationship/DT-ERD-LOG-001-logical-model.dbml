Project DT_ERD {
  database_type: 'PostgreSQL'
  Note: 'Diccionario de Datos Físico y Relacional (Auto-generado desde Markdown)'
}

TableGroup tax {
  "equipment_classes"
  "equipment_units"
  "functional_locations"
  "maintainable_items"
  "subunits"
}

TableGroup mtto {
  "backlog_items"
  "failure_records"
  "maintenance_plans"
  "media_attachments"
  "work_order_histories"
  "work_orders"
  "work_requests"
}

TableGroup inv {
  "inventory_transactions"
  "maintainable_item_spare_parts"
  "material_requirements"
  "spare_parts"
  "suppliers"
  "warehouses"
}

TableGroup vis {
  "isolation_points"
  "mesh_mappings"
  "spatial_metadata"
  "telemetry_signals"
  "visual_layers"
  "work_order_isolations"
  "work_permits"
}

TableGroup adm {
  "audit_logs"
  "auth_tokens"
  "role_permissions"
  "roles"
  "user_roles"
  "users"
  "work_order_assignments"
}

Table "equipment_classes" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "class_name" "VARCHAR(120)" [unique, not null, note: 'Datos maestros a nivel de clase.']
  "description" "VARCHAR(255)" [note: 'Descripción de la clase.']
  "manufacturer_standard" "VARCHAR(120)" [note: 'Referencia de estandarización.']
}

Table "equipment_units" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "serial_number" "VARCHAR(100)" [unique, not null, note: 'Integridad de la identificación del activo.']
  "manufacturer" "VARCHAR(120)" [not null, note: 'Procedencia del activo.']
  "model" "VARCHAR(120)" [not null, note: 'Identificación del tipo de activo.']
  "purchase_date" "DATE" [not null, note: 'Cronología de adquisiciones.']
  "rejection_reason" "VARCHAR(255)" [note: 'Solo está presente cuando se rechaza la adquisición.']
  "boundary_start" "VARCHAR(150)" [not null, note: 'Punto de inicio de la definición del límite.']
  "boundary_end" "VARCHAR(150)" [not null, note: 'Punto final de la definición del límite.']
  "acquisition_date" "DATE" [not null, note: 'Trazabilidad de la adquisición del activo.']
  "installation_date" "DATE" [note: 'La instalación puede estar pendiente.']
  "operation_start_date" "DATE" [note: 'El inicio operativo puede estar pendiente.']
  "operating_hours" "BIGINT" [not null, default: 0, note: 'Seguimiento de confiabilidad y uso.']
  "surveillance_hours" "BIGINT" [not null, default: 0, note: 'Tiempo de vigilancia/standby para cálculo preciso de fallas (ISO 14224).']
  "disposal_date" "DATE" [note: 'Registro de fin de vida para trazabilidad de pasivos (ISO 55000).']
  "disposal_reason" "VARCHAR(255)" [note: 'Razón del retiro o desmantelamiento del activo.']
  "operational_status" "VARCHAR(20)" [not null, note: 'Vocabulario de estado operativo controlado.']
  "lifecycle_status" "VARCHAR(20)" [not null, note: 'Vocabulario de ciclo de vida controlado.']
  "maintenance_status" "VARCHAR(30)" [not null, note: 'Vocabulario de estado de mantenimiento controlado.']
  "health_status" "VARCHAR(30)" [note: 'Vocabulario de estado de salud general (ISO 13374-4).']
  "is_sce" "BOOLEAN" [not null, default: false, note: 'Indicador de Equipo Crítico de Seguridad (Safety Critical Element).']
  "functional_location_id" "UUID" [unique, note: 'Llave foránea hacia la tabla relacionada.']
  "equipment_class_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "warehouse_id" "UUID" [note: 'Llave foránea hacia la tabla relacionada.']
}

Table "functional_locations" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "tag_number" "VARCHAR(50)" [unique, not null, note: 'Identidad del tag de la ISO 14224 y trazabilidad de la ubicación.']
  "name" "VARCHAR(150)" [not null, note: 'Nombre de la ubicación legible por humanos.']
  "description" "VARCHAR(255)" [note: 'Texto explicativo opcional.']
  "criticality" "VARCHAR(30)" [not null, note: 'Vocabulario de prioridad controlado.']
  "geographic_location" "VARCHAR(150)" [note: 'Contexto físico de la ubicación.']
  "environmental_exposure" "VARCHAR(150)" [note: 'Condiciones ambientales para cálculos de confiabilidad (ISO 14224).']
  "hierarchy_level" "SMALLINT" [not null, note: 'Niveles 1 al 5 de la taxonomía ISO 14224 (las Ubicaciones Funcionales gobiernan la estructura espacial de planta hasta el proceso, mientras que L6 a L8 corresponden a equipos y componentes físicos).']
  "parent_id" "UUID" [note: 'Llave foránea hacia la tabla relacionada.']
}

Table "maintainable_items" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "subunit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "component_name" "VARCHAR(120)" [not null, note: 'Identidad del ítem mantenible.']
  "subunit_type" "VARCHAR(80)" [not null, note: 'Clasificación taxonómica.']
  "spare_part_type" "VARCHAR(80)" [note: 'Correspondencia opcional de partes de repuesto.']
  "design_attributes" "JSONB" [note: 'Propiedades estáticas de diseño estructuradas (ISO 14224 Anexo A).']
  "status" "VARCHAR(30)" [not null, note: 'Estado del ciclo de vida del ítem.']
}

Table "subunits" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "subunit_type" "VARCHAR(80)" [not null, note: 'Taxonomía del subcomponente.']
  "name" "VARCHAR(120)" [not null, note: 'Etiqueta del subcomponente.']
}

Table "backlog_items" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "work_request_id" "UUID" [unique, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "priority_score" "INT" [not null, note: 'Puntaje del backlog derivado de RIME (Calculado).']
  "status" "VARCHAR(20)" [not null, note: 'Estado del ciclo de vida del backlog (priorización).']
}

Table "failure_records" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identidad del evento de falla.']
  "work_order_id" "UUID" [unique, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "maintainable_item_id" "UUID" [note: 'Llave foránea hacia la tabla relacionada.']
  "failure_mode" "VARCHAR(120)" [not null, note: 'Codificación de fallas de la ISO 14224.']
  "failure_mechanism" "VARCHAR(120)" [not null, note: 'Codificación de fallas de la ISO 14224.']
  "failure_cause" "VARCHAR(120)" [not null, note: 'Codificación de fallas de la ISO 14224.']
  "detection_method" "VARCHAR(120)" [not null, note: 'Método de detección de la falla (ISO 14224).']
  "operational_condition" "VARCHAR(120)" [not null, note: 'Condición operativa al momento de la falla (ISO 14224).']
  "operational_impact" "VARCHAR(120)" [not null, note: 'Impacto operacional de la falla (ISO 14224).']
  "downtime" "DECIMAL(10,2)" [not null, note: 'Métrica de análisis de confiabilidad (Calculada).']
  "status" "VARCHAR(20)" [not null, note: 'Estado del registro de fallas.']
}

Table "maintenance_plans" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "maintenance_method" "VARCHAR(80)" [not null, note: 'Estrategia de mantenimiento (PM, PdM, CBM).']
  "frequency" "VARCHAR(50)" [not null, note: 'Descripción de la frecuencia legible por humanos.']
  "frequency_type" "VARCHAR(20)" [not null, note: 'Cadencia controlada del plan.']
  "next_work_order_date" "DATE" [note: 'Fecha de ejecución programada (Calculada).']
  "interval_value" "DECIMAL(12,2)" [note: 'Valor numérico del intervalo para telemetría (ej. 500 horas).']
  "next_trigger_limit" "DECIMAL(12,2)" [note: 'Límite acumulado calculado para el próximo disparo.']
  "estimated_labor_hours" "DECIMAL(10,2)" [not null, note: 'Horas-Hombre estimadas (Wrench Time) para planificación.']
  "required_specialty" "VARCHAR(80)" [not null, note: 'Especialidad técnica requerida (ej. Mecánica, Eléctrica).']
  "technical_description" "VARCHAR(255)" [not null, note: 'Descripción técnica del alcance de las tareas.']
  "status" "VARCHAR(20)" [not null, note: 'Estado del ciclo de vida del plan (documento).']
}

Table "media_attachments" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "work_order_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "file_url" "VARCHAR(255)" [not null, note: 'Ubicación de la evidencia.']
  "file_type" "VARCHAR(20)" [not null, note: 'Formato de archivo adjunto controlado.']
  "uploaded_at" "TIMESTAMP" [not null, note: 'Tiempo de subida/ingesta de la evidencia.']
}

Table "work_order_histories" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "work_order_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "old_status" "VARCHAR(20)" [note: 'Estado anterior del ciclo de vida (NULL si es primer estado).']
  "new_status" "VARCHAR(20)" [not null, note: 'Nuevo estado del ciclo de vida.']
  "timestamp" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Tiempo de transición.']
  "duration_seconds" "BIGINT" [note: 'Tiempo empleado en el estado (Calculado al transicionar).']
}

Table "work_orders" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "maintenance_plan_id" "UUID" [note: 'Llave foránea hacia la tabla relacionada.']
  "work_request_id" "UUID" [unique, note: 'Llave foránea hacia la tabla relacionada.']
  "work_permit_id" "UUID" [note: 'Llave foránea hacia la tabla relacionada.']
  "current_status" "VARCHAR(20)" [not null, note: 'Estado del ciclo de vida de ejecución (FSM).']
  "maintenance_method" "VARCHAR(80)" [not null, note: 'Método de mantenimiento (Correctivo, Preventivo, etc.).']
  "creation_date" "TIMESTAMP" [not null, note: 'Marca de tiempo (timestamp) de creación de la orden.']
  "scheduled_date" "TIMESTAMP" [note: 'Inicio planeado.']
  "actual_start" "TIMESTAMP" [note: 'Inicio real de la ejecución.']
  "actual_finish" "TIMESTAMP" [note: 'Finalización real de la ejecución.']
  "actual_labor_hours" "DECIMAL(10,2)" [note: 'Duración laboral real (Calculada).']
  "criticality" "VARCHAR(20)" [not null, note: 'Etiqueta de criticidad / prioridad de la OT.']
}

Table "work_requests" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "description" "VARCHAR(255)" [not null, note: 'Narrativa de la solicitud.']
  "priority" "VARCHAR(20)" [not null, note: 'Etiqueta de prioridad de la solicitud.']
  "request_date" "TIMESTAMP" [not null, note: 'Línea de tiempo para auditoría.']
  "request_source" "VARCHAR(80)" [not null, note: 'Origen de la solicitud.']
  "status" "VARCHAR(20)" [not null, note: 'Estado del ciclo de vida de la solicitud.']
  "work_class_code" "SMALLINT" [not null, note: 'Peso numérico de la clase de trabajo seleccionada para el RIME.']
}

Table "inventory_transactions" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "spare_part_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "warehouse_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "work_order_id" "UUID" [note: 'Llave foránea hacia la tabla relacionada.']
  "quantity" "DECIMAL(12,4)" [not null, default: 1, note: 'Cantidad transada (positiva para entradas, negativa para salidas).']
  "transaction_type" "VARCHAR(20)" [not null, note: 'Tipo de movimiento (RECEIPT, ISSUE, ADJUSTMENT).']
  "timestamp" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Registro temporal preciso del movimiento.']
  "reason" "VARCHAR(255)" [not null, note: 'Razón del movimiento o referencia a documentos externos.']
  "total_cost" "DECIMAL(12,2)" [not null, note: 'Costo total de la transacción (Cantidad \* Costo).']
  "aisle_shelf_location" "VARCHAR(150)" [note: 'Ubicación física específica de la transacción (pasillo/estante).']
  "serial_number" "VARCHAR(100)" [note: 'Número de serie o Tag del equipo rotativo (Asset Swap).']
}

Table "maintainable_item_spare_parts" {
  "maintainable_item_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "spare_part_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
}

Table "material_requirements" {
  "work_order_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "spare_part_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "planned_quantity" "DECIMAL(12,4)" [not null, default: 1, note: 'Repuestos planificados antes de la ejecución de la OT.']
  "actual_quantity" "DECIMAL(12,4)" [note: 'Repuestos realmente consumidos durante la ejecución de la OT.']
  "is_reserved" "BOOLEAN" [not null, note: 'Bandera que indica si el stock ya fue apartado en almacén.']
}

Table "spare_parts" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "sku" "VARCHAR(80)" [unique, not null, note: 'Identidad de la parte.']
  "description" "VARCHAR(255)" [not null, note: 'Descripción de la parte legible por humanos.']
  "manufacturer" "VARCHAR(120)" [not null, note: 'Identidad del proveedor/fabricante.']
  "commodity_code" "VARCHAR(80)" [note: 'Código de clasificación.']
  "reorder_point" "DECIMAL(12,4)" [not null, note: 'Umbral mínimo de activación de compra.']
  "unit_of_measure" "VARCHAR(20)" [not null, note: 'Unidad de medida estándar (UoM).']
  "stock_policy" "VARCHAR(20)" [not null, note: 'Política de reabastecimiento (Min/Max, Reorder Point, JIT).']
  "is_rebuildable" "BOOLEAN" [not null, default: false, note: 'Indica si la parte se desecha o se envía a taller para reparación.']
  "quantity_on_hand" "DECIMAL(12,4)" [not null, note: 'Cantidad actualmente en inventario físico.']
  "reserved_quantity" "DECIMAL(12,4)" [not null, note: 'Stock comprometido para órdenes planificadas.']
  "max_capacity" "DECIMAL(12,4)" [not null, note: 'Límite físico del almacén para la parte.']
  "unit_cost" "DECIMAL(12,2)" [not null, note: 'Costo unitario estándar de adquisición.']
  "status" "VARCHAR(20)" [not null, note: 'Estado de disponibilidad del repuesto.']
  "supplier_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "equipment_class_id" "UUID" [note: 'Llave foránea hacia la tabla relacionada.']
}

Table "suppliers" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "name" "VARCHAR(120)" [not null, note: 'Identidad comercial del proveedor.']
  "contact_info" "VARCHAR(255)" [not null, note: 'Teléfono, correo o dirección de contacto.']
  "warranty_terms" "VARCHAR(255)" [not null, note: 'Términos estándar de garantía comercial.']
}

Table "warehouses" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "name" "VARCHAR(80)" [not null, note: 'Identidad del almacén.']
  "location" "VARCHAR(255)" [not null, note: 'Dirección o ubicación física del almacén.']
  "capacity" "DECIMAL(12,4)" [not null, note: 'Capacidad máxima volumétrica o de carga del almacén.']
}

Table "isolation_points" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "isolation_tag" "VARCHAR(80)" [unique, not null, note: 'Identidad del punto de aislamiento.']
  "isolation_type" "VARCHAR(20)" [not null, note: 'Vocabulario de aislamiento.']
  "is_verified" "BOOLEAN" [not null, default: false, note: 'Estado de verificación.']
}

Table "mesh_mappings" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [unique, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "mesh_uuid" "VARCHAR(80)" [unique, not null, note: 'Identidad o ruta del modelo 3D del activo.']
  "mapping_status" "VARCHAR(20)" [not null, note: 'Estado de vinculación del gemelo digital.']
  "last_sync_time" "TIMESTAMP" [note: 'Tiempo de la última sincronización.']
}

Table "spatial_metadata" {
  "mesh_mapping_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "position" "JSONB" [not null, note: 'Coordenada espacial vectorial (ej. x,y,z).']
  "rotation" "JSONB" [note: 'Descriptor de orientación (ej. cuaternión).']
  "scale" "JSONB" [note: 'Descriptor de escala.']
}

Table "telemetry_signals" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "signal_type" "VARCHAR(80)" [not null, note: 'Etiqueta de la señal del sensor.']
  "value" "DECIMAL(18,6)" [not null, note: 'Valor de la medición cruda.']
  "unit" "VARCHAR(20)" [not null, note: 'Unidad de medición.']
  "threshold" "DECIMAL(18,6)" [note: 'Umbral de alerta.']
  "timestamp" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Tiempo de medición.']
  "is_safety_critical" "BOOLEAN" [not null, note: 'Bandera de clasificación de seguridad.']
}

Table "visual_layers" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "work_order_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "layer_type" "VARCHAR(80)" [not null, note: 'Tipo de representación visual.']
  "opacity_level" "DECIMAL(5,2)" [not null, note: 'Control de renderizado.']
  "status" "VARCHAR(20)" [not null, note: 'Estado de la capa visual.']
}

Table "work_order_isolations" {
  "work_order_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "isolation_point_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "is_isolated" "BOOLEAN" [not null, default: false, note: 'Estado de bloqueo verificado para el trabajo específico.']
  "isolated_at" "TIMESTAMP" [note: 'Marca de tiempo en que se ejecutó el bloqueo.']
  "padlock_tag_id" "VARCHAR(80)" [note: 'Identificador del candado o etiqueta física (Try-Out).']
}

Table "work_permits" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "equipment_unit_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "permit_identifier" "VARCHAR(80)" [unique, not null, note: 'Trazabilidad del permiso.']
  "permit_type" "VARCHAR(30)" [not null, note: 'Vocabulario de permisos.']
  "contractor_name" "VARCHAR(150)" [not null, note: 'Identificación del contratista.']
  "status" "VARCHAR(20)" [not null, note: 'Estado del ciclo de vida del permiso.']
}

Table "audit_logs" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "user_id" "UUID" [note: 'Llave foránea hacia la tabla relacionada.']
  "entity_type" "VARCHAR(80)" [not null, note: 'Nombre de la tabla/entidad auditada.']
  "entity_identifier" "VARCHAR(80)" [not null, note: 'Identificador UUID de la fila modificada.']
  "action_type" "VARCHAR(20)" [not null, note: 'Tipo de operación DML (CREATE, UPDATE, DELETE).']
  "timestamp" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Registro temporal preciso del evento de cambio.']
  "previous_state" "JSONB" [note: 'Representación JSON descompuesta binaria antes de la acción.']
  "new_state" "JSONB" [note: 'Representación JSON descompuesta binaria después de la acción.']
  "integrity_hash" "VARCHAR(255)" [not null, note: 'Hash SHA-256 encadenado para detectar manipulación del log.']
}

Table "auth_tokens" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "user_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "token_hash" "VARCHAR(255)" [unique, not null, note: 'Hash del token de autenticación API / sesión.']
  "expires_at" "TIMESTAMP" [not null, note: 'Fecha y hora de expiración del token.']
  "is_used" "BOOLEAN" [not null, default: false, note: 'Indica si el token ya fue consumido (uso único).']
  "ip_address" "VARCHAR(45)" [note: 'Dirección IP desde la que se emitió el token (IPv4/IPv6).']
  "user_agent" "VARCHAR(255)" [note: 'Identificador del cliente/navegador para fingerprinting.']
}

Table "role_permissions" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "role_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "module" "VARCHAR(80)" [not null, note: 'Módulo del sistema (ej. MTTO, INV, VIS).']
  "action" "VARCHAR(80)" [not null, note: 'Acción permitida (ej. READ, CREATE, UPDATE, SIGN_OFF).']
}

Table "roles" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "role_name" "VARCHAR(80)" [unique, not null, note: 'Identificador del rol de usuario (ej. Planner, Technician).']
  "description" "VARCHAR(255)" [note: 'Descripción del alcance del rol.']
  "is_system_role" "BOOLEAN" [not null, note: 'Bandera para roles inmutables del sistema.']
}

Table "user_roles" {
  "user_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
  "role_id" "UUID" [pk, not null, note: 'Llave foránea hacia la tabla relacionada.']
}

Table "users" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "username" "VARCHAR(80)" [unique, not null, note: 'Identidad de la cuenta de usuario.']
  "full_name" "VARCHAR(150)" [not null, note: 'Nombre completo o institucional del usuario.']
  "email" "VARCHAR(150)" [unique, not null, note: 'Correo electrónico institucional y de contacto.']
  "status" "VARCHAR(20)" [not null, note: 'Estado de la cuenta (ACTIVE, INACTIVE, LOCKED).']
  "password_hash" "VARCHAR(255)" [not null, note: 'Hash de la contraseña de acceso (PBKDF2/BCrypt).']
  "failed_login_attempts" "INT" [not null, default: 0, note: 'Contador de intentos fallidos de autenticación.']
  "lockout_until" "TIMESTAMP" [note: 'Fin del periodo de bloqueo temporal.']
  "mfa_enabled" "BOOLEAN" [not null, default: false, note: 'Bandera que indica si la autenticación multifactor está activa.']
  "totp_secret" "VARCHAR(255)" [note: 'Secreto compartido para autenticación TOTP (Autenticador).']
  "deactivation_reason" "VARCHAR(255)" [note: 'Justificación administrativa para el borrado lógico (ISO 27001).']
}

Table "work_order_assignments" {
  "id" "UUID" [pk, not null, default: `uuidv7()`, note: 'Identificador único de la entidad (PK).']
  "work_order_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "user_id" "UUID" [not null, note: 'Llave foránea hacia la tabla relacionada.']
  "role_in_work" "VARCHAR(50)" [not null, note: 'Rol funcional en la orden de trabajo (TECHNICIAN, SUPERVISOR).']
  "assigned_at" "TIMESTAMP" [not null, default: `clock_timestamp()`, note: 'Registro temporal de la asignación.']
}

