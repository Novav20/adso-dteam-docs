@startuml ADM-UseCases
skinparam packageStyle rectangle
left to right direction

' --- CONFIGURACIÓN VISUAL ---
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2E86C1
  BorderThickness 2
  FontName Segoe UI
  FontSize 12
}
skinparam actor {
  BackgroundColor #1B4F72
  BorderColor #154360
  FontName Segoe UI
  FontSize 11
}
skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #AED6F1
  FontName Segoe UI
  FontSize 13
  FontStyle bold
}
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

legend top right
|= Control Documental (ISO 9001:2015) |
| **Código:** DT-UCD-ADM-001 |
