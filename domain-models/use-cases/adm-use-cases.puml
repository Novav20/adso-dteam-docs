  usecase "UC-ADM-017\nDashboard Ejecutivo\nde KPIs (MTBF/MTTR)" as UCADM017 #EBF5FB
  usecase "UC-ADM-018\nGenerar Reportes\nEjecutivos (PDF/A)" as UCADM018 #EBF5FB
  usecase "UC-ADM-019\nSincronizar Datos\ncon Herramientas BI" as UCADM019 #EBF5FB
  usecase "UC-ADM-022\nSugerencias de\nOptimización (PMO)" as UCADM022 #EBF5FB
