' Source academic evidence: sena-evidence/01-Analysis/AP2-Conceptual-Model/GA2-220501093/AA1/EV02-Use-Cases/Casos-Uso-MTTO.md
' Module: MTTO
' Purpose: Technical PlantUML source extracted from academic narrative for reuse in technical documentation.

@startuml MTTO-UseCases
skinparam packageStyle rectangle
left to right direction

' Configuración de colores profesionales
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2E86C1
  BorderThickness 2
  FontName Segoe UI
  FontSize 12
}

skinparam actor {
  BackgroundColor #1B4F72
  BorderColor #154360
  FontName Segoe UI
  FontSize 11
}

skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #AED6F1
  FontName Segoe UI
  FontSize 13
  FontStyle bold
}

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

' Actores
actor "Técnico de\nMantenimiento" as Tecnico #1B4F72
actor "Planificador de\nMantenimiento" as Planificador #1B4F72
actor "Ingeniero de\nConfiabilidad" as Ingeniero #1B4F72
actor "Supervisor de\nMantenimiento" as Supervisor #1B4F72
actor "Contratista" as Contratista #1B4F72

' Paquete principal
package "Módulo de Mantenimiento" {

  ' Casos de Uso - Planificación
  usecase "UC-MTTO-001\nProgramar\nMantenimiento\nPreventivo" as UC001 #EBF5FB
  usecase "UC-MTTO-002\nPriorizar Backlog\nmediante RIME" as UC002 #EBF5FB

  ' Casos de Uso - Ejecución
  usecase "UC-MTTO-003\nCerrar OT con\nTaxonomía ISO 14224" as UC003 #EBF5FB
  usecase "UC-MTTO-004\nCargar Evidencia\nMultimedia (PDF)" as UC004 #EBF5FB
  usecase "UC-MTTO-005\nExtraer Datos con IA\n(LLM)" as UC005 #EBF5FB

  ' Casos de Uso - Consulta y Soporte
  usecase "UC-MTTO-006\nConsultar Chatbot\nRAG Técnico" as UC006 #EBF5FB
  usecase "UC-MTTO-007\nVisualizar\nDocumentación Móvil" as UC007 #EBF5FB

  ' Casos de Uso - Gestión de Activos
  usecase "UC-MTTO-008\nDefinir Límites\nde Activos (Boundaries)" as UC008 #EBF5FB
  usecase "UC-MTTO-009\nGestionar\nGarantías de Activos" as UC009 #EBF5FB
}

' Relaciones Actor-Caso de Uso
Planificador --> UC001
Planificador --> UC002
Tecnico --> UC003
Contratista --> UC004
Supervisor --> UC005
Tecnico --> UC006
Tecnico --> UC007
Ingeniero --> UC008
Planificador --> UC009

' Relaciones entre Casos de Uso (Include/Extend)
UC003 ..> UC004 : <<include>>
UC004 ..> UC005 : <<include>>
UC001 ..> UC008 : <<precondition>>
UC006 ..> UC007 : <<extend>>

@enduml
