' Source academic evidence: sena-evidence/01-Analysis/AP2-Conceptual-Model/GA2-220501093/AA1/EV02-Use-Cases/Casos-Uso-INV.md
' Module: INV
' Purpose: Technical PlantUML source extracted from academic narrative for reuse in technical documentation.

@startuml INV-UseCases
skinparam packageStyle rectangle
left to right direction

' Configuración de colores profesionales
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2E86C1
  BorderThickness 2
  FontName Segoe UI
  FontSize 12
}

skinparam actor {
  BackgroundColor #1B4F72
  BorderColor #154360
  FontName Segoe UI
  FontSize 11
}

skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #AED6F1
  FontName Segoe UI
  FontSize 13
  FontStyle bold
}

skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

' Actores
actor "Jefe de\nAlmacén" as JefeAlmacen #1B4F72
actor "Ingeniero de\nProyectos" as IngenieroProyectos #1B4F72
actor "Ingeniero de\nConfiabilidad" as IngenieroConfiabilidad #1B4F72
actor "Técnico de\nMantenimiento" as Tecnico #1B4F72

' Paquete principal
package "Módulo de Inventario" {

  usecase "UC-INV-001\nCrear Ficha\nTécnica de\nActivo" as UCINV001 #EBF5FB
  usecase "UC-INV-002\nGestionar\nMovimientos de\nInventario" as UCINV002 #EBF5FB
  usecase "UC-INV-003\nValidar y\nActivar Activos" as UCINV003 #EBF5FB
  usecase "UC-INV-004\nMonitor de\nReabastecimiento" as UCINV004 #EBF5FB
  usecase "UC-INV-005\nCrear Ubicaciones\nFuncionales" as UCINV005 #EBF5FB
  usecase "UC-INV-006\nGestionar Catálogo\nde Repuestos\nMaestro" as UCINV006 #EBF5FB
}

' Relaciones Actor-Caso de Uso
IngenieroProyectos --> UCINV001
JefeAlmacen --> UCINV002
IngenieroConfiabilidad --> UCINV003
JefeAlmacen --> UCINV004
IngenieroProyectos --> UCINV005
JefeAlmacen --> UCINV006
Tecnico --> UCINV002

' Relaciones entre Casos de Uso
UCINV001 ..> UCINV005 : <<include>>
UCINV002 ..> UCINV006 : <<precondition>>
UCINV004 ..> UCINV006 : <<include>>

@enduml
