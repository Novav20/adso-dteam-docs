@startuml MTTO-UseCases
skinparam packageStyle rectangle
left to right direction

' --- CONFIGURACIÓN VISUAL ---
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2E86C1
  BorderThickness 2
  FontName Segoe UI
  FontSize 12
}
skinparam actor {
  BackgroundColor #1B4F72
  BorderColor #154360
  FontName Segoe UI
  FontSize 11
}
skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #AED6F1
  FontName Segoe UI
  FontSize 13
  FontStyle bold
}
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

legend top right
|= Control Documental (ISO 9001:2015) |
| **Código:** DT-UCD-MTTO-001 |
| **Versión:** 1.2 |
| **Fecha:** 2026-08-03 |
| **Estado:** Completado |
| **Autor:** Juan David Julio Serrano |
endlegend

' --- ACTORES ---
actor "Técnico de\nMantenimiento" as Tecnico #1B4F72
actor "Planificador de\nMantenimiento" as Planificador #1B4F72
actor "Ingeniero de\nConfiabilidad" as Ingeniero #1B4F72
actor "Supervisor de\nMantenimiento" as Supervisor #1B4F72
actor "Contratista" as Contratista #1B4F72

' --- PAQUETE PRINCIPAL ---
package "Módulo de Operaciones de Mantenimiento (MTTO)" {

  ' Casos de Uso - Planificación y Priorización
  usecase "UC-MTTO-001\nProgramar Mantenimiento\nPreventivo (Tiempo)" as UCMTTO001 #EBF5FB
  usecase "UC-MTTO-023\nProgramar Mantenimiento\npor Telemetría" as UCMTTO023 #EBF5FB
  usecase "UC-MTTO-026\nPriorizar Backlog\nmediante RIME" as UCMTTO026 #EBF5FB

  ' Casos de Uso - Ejecución en Campo
  usecase "UC-MTTO-002\nCerrar Orden de Trabajo con\nTaxonomía ISO 14224" as UCMTTO002 #EBF5FB
  usecase "UC-MTTO-003\nCargar Informe de\nContratista (PDF)" as UCMTTO003 #EBF5FB
  usecase "UC-MTTO-004\nExtraer Datos\nde Informe con IA" as UCMTTO004 #EBF5FB

  ' Casos de Uso - Consulta y Soporte
  usecase "UC-MTTO-020\nVisualizar\nDocumentación Móvil" as UCMTTO020 #EBF5FB
  usecase "UC-MTTO-028\nConsultar Chatbot\nRAG Técnico" as UCMTTO028 #EBF5FB

  ' Casos de Uso - Ingeniería y Confiabilidad
  usecase "UC-MTTO-029\nDefinir Límites\nde Activos" as UCMTTO029 #EBF5FB
  usecase "UC-MTTO-030\nGestionar\nGarantías de Activos" as UCMTTO030 #EBF5FB
}

' --- RELACIONES ACTOR - CASO DE USO ---
Planificador --> UCMTTO001
Planificador --> UCMTTO023
Planificador --> UCMTTO026
Planificador --> UCMTTO030

Tecnico --> UCMTTO002
Tecnico --> UCMTTO020
Tecnico --> UCMTTO028

Contratista --> UCMTTO003
Supervisor --> UCMTTO004
Ingeniero --> UCMTTO029

' --- RELACIONES INTER-CASOS DE USO (Include/Extend) ---
UCMTTO003 ..> UCMTTO002 : <<extend>>
UCMTTO004 ..> UCMTTO003 : <<extend>>
UCMTTO028 ..> UCMTTO020 : <<extend>>

@enduml