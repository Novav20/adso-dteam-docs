@startuml INV-UseCases
skinparam packageStyle rectangle
left to right direction

' --- CONFIGURACIÓN VISUAL ---
skinparam usecase {
  BackgroundColor #EBF5FB
  BorderColor #2E86C1
  BorderThickness 2
  FontName Segoe UI
  FontSize 12
}
skinparam actor {
  BackgroundColor #1B4F72
  BorderColor #154360
  FontName Segoe UI
  FontSize 11
}
skinparam package {
  BackgroundColor #FDFEFE
  BorderColor #AED6F1
  FontName Segoe UI
  FontSize 13
  FontStyle bold
}
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12

legend top right
|= Control Documental (ISO 9001:2015) |
| **Código:** DT-UCD-INV-001 |
| **Versión:** 1.1 |
| **Fecha:** 2026-07-16 |
| **Estado:** Integración de Rotación de Activos Completada |
| **Autor:** Juan David Julio Serrano |
endlegend

' --- ACTORES ---
actor "Jefe de\nAlmacén" as JefeAlmacen #1B4F72
actor "Ingeniero de\nProyectos" as IngenieroProyectos #1B4F72
actor "Ingeniero de\nConfiabilidad" as IngenieroConfiabilidad #1B4F72
actor "Técnico de\nMantenimiento" as Tecnico #1B4F72

' --- PAQUETE PRINCIPAL ---
package "Módulo de Control de Recursos (INV)" {

  usecase "UC-INV-005\nCrear Ficha Técnica\nde Activo (Equipment Unit)" as UCINV005 #EBF5FB
  usecase "UC-INV-006\nGestionar Movimientos\nde Inventario" as UCINV006 #EBF5FB
  usecase "UC-INV-007\nValidar y Activar\nActivos Nuevos" as UCINV007 #EBF5FB
  usecase "UC-INV-021\nMonitor de\nReabastecimiento" as UCINV021 #EBF5FB
  usecase "UC-INV-025\nRotación de Activos\n(Asset Swap)" as UCINV025 #EBF5FB
  usecase "UC-INV-027\nCrear Ubicaciones\nFuncionales" as UCINV027 #EBF5FB
  usecase "UC-INV-031\nGestionar Catálogo de\nRepuestos Maestro" as UCINV031 #EBF5FB
}

' --- RELACIONES ACTOR - CASO DE USO ---
IngenieroProyectos --> UCINV005
IngenieroProyectos --> UCINV027
IngenieroProyectos --> UCINV025

JefeAlmacen --> UCINV006
JefeAlmacen --> UCINV021
JefeAlmacen --> UCINV031

IngenieroConfiabilidad --> UCINV007
Tecnico --> UCINV006

