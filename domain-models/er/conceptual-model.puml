@startuml ConceptualModel
' --- CONFIGURACIÓN VISUAL ---
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

' Paleta de colores consistente con el modelo de dominio
skinparam class {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    BorderThickness 1.5
    ArrowColor #154360
    AttributeIconSize 0
}

skinparam package {
    BackgroundColor #F8F9F9
    BorderColor #1B4F72
    BorderThickness 1.5
    FontStyle bold
}

' Leyenda e Información General (ISO 9001:2015)
legend top right
    |= Control Documental (ISO 9001:2015) |
    | **Código:** DT-ERD-CON-001 |
    | **Versión:** 1.7 |
    | **Fecha:** 2026-05-24 |
    | **Estado:** Auditoría Normativa Completada |
    | **Autor:** Juan David Julio Serrano |
endlegend

package "Taxonomía de Activos (ISO 14224)" as taxonomy_module {
    entity "FunctionalLocation" as functional_locations {
        tag_number (Identifier)
        name
        description
        criticality
        geographic_location
        hierarchy_level
    }

    entity "EquipmentClass" as equipment_classes {
        class_name (Identifier)
        description
        manufacturer_standard
    }

    entity "EquipmentUnit" as equipment_units {
        serial_number (Identifier)
        manufacturer
        model
        purchase_date
        acquisition_date
        installation_date
        operation_start_date
        operating_hours
        surveillance_hours
        disposal_date
        disposal_reason
        operational_status
        lifecycle_status
        maintenance_status
        health_status
    }

    entity "Subunit" as subunits {
        subunit_type
        name
    }

    entity "MaintainableItem" as maintainable_items {
        component_name
        spare_part_type
        design_attributes
        status
    }
}

package "Operaciones de Mantenimiento (MTTO)" as maintenance_module {
    entity "WorkRequest" as work_requests {
        description
        priority
        request_date
        request_source
        status
        risk_factor
        impact_factor
        maintainability_factor
        economy_factor
    }

    entity "MaintenancePlan" as maintenance_plans {
        maintenance_method
        frequency
        frequency_type
        next_work_order_date
        status
    }

    entity "WorkOrder" as work_orders {
        current_status
        maintenance_method
        creation_date
        scheduled_date
        actual_start
        actual_finish
        actual_labor_hours
        criticality
    }

    entity "WorkOrderHistory" as work_order_histories {
        old_status
        new_status
        timestamp
        duration_seconds
    }

    entity "FailureRecord" as failure_records {
        failure_mode
        failure_mechanism
        failure_cause
        downtime
        status
    }

    entity "MediaAttachment" as media_attachments {
        file_url
        file_type
        uploaded_at
    }
}

package "Control de Recursos (INV)" as inventory_module {
    entity "SparePart" as spare_parts {
        sku (Identifier)
        description
        manufacturer
        commodity_code
        reorder_point
        unit_of_measure
        stock_policy
        quantity_on_hand
        reserved_quantity
        max_capacity
        unit_cost
        is_rebuildable
        status
    }

    entity "InventoryTransaction" as inventory_transactions {
        quantity
        transaction_type
        timestamp
        reason
        total_cost
    }

    entity "Warehouse" as warehouses {
        name
        location
        capacity
    }

    entity "Supplier" as suppliers {
        name
        contact_info
        warranty_terms
    }
}

package "Convergencia Gemelo Digital (VIS)" as visual_module {
    entity "MeshMapping" as mesh_mappings {
        mesh_uuid
        mapping_status
        last_sync_time
        position
        rotation
        scale
    }

    entity "TelemetrySignal" as telemetry_signals {
        signal_type
        value
        unit
        threshold
        timestamp
        is_safety_critical
    }

    entity "WorkPermit" as work_permits {
        permit_identifier
        permit_type
        contractor_name
        status
    }

    entity "IsolationPoint" as isolation_points {
        isolation_tag
        isolation_type
        is_verified
    }

    entity "VisualLayer" as visual_layers {
        layer_type
        opacity_level
        status
    }
}

package "Seguridad y Gobernanza (ADM)" as admin_module {
    entity "User" as users {
        username (Identifier)
        email
        status
        password_hash
        failed_login_attempts
        lockout_until
        mfa_enabled
        totp_secret
    }

    entity "Role" as roles {
        role_name (Identifier)
        description
        is_system_role
    }

    entity "Permission" as permissions {
        module
        action
    }

    entity "AuthToken" as auth_tokens {
        token_hash
        expires_at
        is_used
        ip_address
        user_agent
    }

    entity "WorkOrderAssignment" as work_order_assignments {
        role_in_work
        assigned_at
    }

    entity "AuditLog" as audit_logs {
        entity_type
        action_type
        timestamp
        entity_identifier
        previous_state
        new_state
        integrity_hash
    }
}

' --- RELACIONES CONCEPTUALES ---

' Taxonomía
functional_locations "1" -- "0..*" functional_locations : "contiene"
functional_locations "1" -- "0..1" equipment_units : "aloja"
equipment_classes "1" -- "0..*" equipment_units : "clasifica"
equipment_units "1" -- "1..*" subunits : "se compone de"
subunits "1" -- "1..*" maintainable_items : "contiene"

' Mantenimiento
equipment_units "1" -- "0..*" work_requests : "genera"
equipment_units "1" -- "0..*" maintenance_plans : "tiene"
equipment_units "1" -- "0..*" work_orders : "recibe"
maintainable_items "0..1" -- "0..*" work_requests : "asociado a"
maintainable_items "0..1" -- "0..*" maintenance_plans : "asociado a"
work_requests "0..1" -- "0..1" work_orders : "se convierte en"
maintenance_plans "1" -- "0..*" work_orders : "programa"
work_orders "1" -- "0..*" work_order_histories : "registra"
work_orders "1" -- "0..1" failure_records : "reporta"
work_orders "1" -- "0..*" media_attachments : "adjunta"
equipment_classes "1" -- "0..*" failure_records : "define modos de"

' Inventario
maintainable_items "1" -- "0..*" spare_parts : "requiere"
spare_parts "1" -- "0..*" inventory_transactions : "genera"
warehouses "1" -- "0..*" inventory_transactions : "registra en"
work_orders "1" -- "0..*" inventory_transactions : "consume"
suppliers "1" -- "0..*" spare_parts : "provee"
equipment_classes "1" -- "0..*" spare_parts : "estandariza"

' Gemelo Digital (VIS)
equipment_units "1" -- "0..1" mesh_mappings : "vincula"
equipment_units "1" -- "0..*" telemetry_signals : "transmite"
equipment_units "1" -- "0..*" work_permits : "requiere para"
work_permits "1" -- "1..*" isolation_points : "exige"
work_orders "1" -- "0..*" visual_layers : "proyecta en"

' Gobernanza / Seguridad (ADM)
users "1" -- "1..*" roles : "tiene"
roles "1" -- "0..*" permissions : "concede"
users "1" -- "0..*" auth_tokens : "inicia"
users "1" -- "0..*" work_order_assignments : "ejecuta"
work_orders "1" -- "0..*" work_order_assignments : "asigna a"
audit_logs "0..*" -- "1" users : "registra accion de"

@enduml
