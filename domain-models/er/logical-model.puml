@startuml LogicalModel
' --- CONFIGURACIÓN VISUAL ---
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

' Paleta de colores consistente con el modelo de dominio
skinparam class {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    BorderThickness 1.5
    ArrowColor #154360
    AttributeIconSize 0
}

' Paquetes con borde más oscuro y fondo de contraste
skinparam package {
    BackgroundColor #F8F9F9
    BorderColor #1B4F72
    BorderThickness 1.5
    FontStyle bold
}

' Leyenda e Información General (ISO 9001:2015)
legend top right
    |= Control Documental (ISO 9001:2015) |
    | **Código:** DT-ERD-LOG-001 |
    | **Versión:** 1.3-Draft |
    | **Fecha:** 2026-05-22 |
    | **Estado:** En Revisión (Segmento C - Sincronizado) |
    | **Autor:** Juan David |
endlegend

package "Taxonomía de Activos (ISO 14224)" as taxonomy_module {
    entity "functional_locations" as functional_locations {
        * id : UUID <<PK>>
        --
        * tag_number : VARCHAR(50) <<unique>>
        * name : VARCHAR(150)
        description : VARCHAR(255)
        * criticality : VARCHAR(30)
        geographic_location : VARCHAR(150)
        * hierarchy_level : SMALLINT
        parent_id : UUID <<FK>>
    }

    entity "equipment_classes" as equipment_classes {
        * id : UUID <<PK>>
        --
        * class_name : VARCHAR(120) <<unique>>
        description : VARCHAR(255)
        manufacturer_standard : VARCHAR(120)
    }

    entity "equipment_units" as equipment_units {
        * id : UUID <<PK>>
        --
        * serial_number : VARCHAR(100) <<unique>>
        * manufacturer : VARCHAR(120)
        * model : VARCHAR(120)
        * purchase_date : DATE
        rejection_reason : VARCHAR(255)
        * boundary_start : VARCHAR(150)
        * boundary_end : VARCHAR(150)
        * acquisition_date : DATE
        installation_date : DATE
        operation_start_date : DATE
        * operating_hours : BIGINT
        * operational_status : VARCHAR(20)
        * lifecycle_status : VARCHAR(20)
        * maintenance_status : VARCHAR(30)
        functional_location_id : UUID <<FK, unique>>
        * equipment_class_id : UUID <<FK>>
    }

    entity "subunits" as subunits {
        * id : UUID <<PK>>
        --
        * equipment_unit_id : UUID <<FK>>
        * subunit_type : VARCHAR(80)
        * name : VARCHAR(120)
    }

    entity "maintainable_items" as maintainable_items {
        * id : UUID <<PK>>
        --
        * subunit_id : UUID <<FK>>
        * component_name : VARCHAR(120)
        * subunit_type : VARCHAR(80)
        spare_part_type : VARCHAR(80)
        design_attributes : VARCHAR(255)
        * status : VARCHAR(30)
    }
}

' Relaciones
functional_locations ||--o{ functional_locations : "parent_id"
functional_locations ||--o| equipment_units : "instala"
equipment_classes ||--o{ equipment_units : "categoriza"
equipment_units ||--|{ subunits : "se compone de (ON DELETE CASCADE)"
subunits ||--|{ maintainable_items : "contiene (ON DELETE CASCADE)"

package "Operaciones de Mantenimiento (MTTO)" as mtto_module {
    entity "work_requests" as work_requests {
        * id : UUID <<PK>>
        --
        * equipment_unit_id : UUID <<FK>>
        * description : VARCHAR(255)
        * priority : VARCHAR(20)
        * request_date : TIMESTAMP
        * request_source : VARCHAR(80)
        * status : VARCHAR(20)
        * risk_factor : VARCHAR(20)
        * impact_factor : VARCHAR(20)
        * maintainability_factor : VARCHAR(20)
        * economy_factor : VARCHAR(20)
    }

    entity "maintenance_plans" as maintenance_plans {
        * id : UUID <<PK>>
        --
        * equipment_unit_id : UUID <<FK>>
        * maintenance_method : VARCHAR(80)
        * frequency : VARCHAR(50)
        * frequency_type : VARCHAR(20)
        * next_work_order_date : DATE
        * status : VARCHAR(20)
    }

    entity "work_orders" as work_orders {
        * id : UUID <<PK>>
        --
        * equipment_unit_id : UUID <<FK>>
        maintenance_plan_id : UUID <<FK>>
        work_request_id : UUID <<FK, unique>>
        * current_status : VARCHAR(20)
        * maintenance_method : VARCHAR(80)
        * creation_date : TIMESTAMP
        scheduled_date : TIMESTAMP
        actual_start : TIMESTAMP
        actual_finish : TIMESTAMP
        actual_labor_hours : DECIMAL(10,2)
        * criticality : VARCHAR(20)
    }

    entity "work_order_histories" as work_order_histories {
        * id : UUID <<PK>>
        --
        * work_order_id : UUID <<FK>>
        old_status : VARCHAR(20)
        * new_status : VARCHAR(20)
        * timestamp : TIMESTAMP
        duration_seconds : BIGINT
    }

    entity "failure_records" as failure_records {
        * id : UUID <<PK>>
        --
        * work_order_id : UUID <<FK, unique>>
        maintainable_item_id : UUID <<FK>>
        * failure_mode : VARCHAR(120)
        * failure_mechanism : VARCHAR(120)
        * failure_cause : VARCHAR(120)
        * downtime : DECIMAL(10,2)
        * status : VARCHAR(20)
    }

    entity "backlog_items" as backlog_items {
        * id : UUID <<PK>>
        --
        * equipment_unit_id : UUID <<FK>>
        * work_request_id : UUID <<FK, unique>>
        * priority_score : INT
        * status : VARCHAR(20)
    }

    entity "media_attachments" as media_attachments {
        * id : UUID <<PK>>
        --
        * work_order_id : UUID <<FK>>
        * file_url : VARCHAR(255)
        * file_type : VARCHAR(20)
        * uploaded_at : TIMESTAMP
    }
}

package "Control de Recursos (INV)" as inv_module {
    entity "suppliers" as suppliers {
        * id : UUID <<PK>>
        --
        * name : VARCHAR(120)
        * contact_info : VARCHAR(255)
        * warranty_terms : VARCHAR(255)
    }

    entity "warehouses" as warehouses {
        * id : UUID <<PK>>
        --
        * name : VARCHAR(80)
        * location : VARCHAR(255)
        * capacity : DECIMAL(12,4)
    }

    entity "spare_parts" as spare_parts {
        * id : UUID <<PK>>
        --
        * sku : VARCHAR(80) <<unique>>
        * description : VARCHAR(255)
        * manufacturer : VARCHAR(120)
        commodity_code : VARCHAR(80)
        * reorder_point : DECIMAL(12,4)
        * unit_of_measure : VARCHAR(20)
        * stock_policy : VARCHAR(20)
        * quantity_on_hand : DECIMAL(12,4)
        * reserved_quantity : DECIMAL(12,4)
        * max_capacity : DECIMAL(12,4)
        * unit_cost : DECIMAL(12,2)
        * status : VARCHAR(20)
        * supplier_id : UUID <<FK>>
        equipment_class_id : UUID <<FK>>
    }

    entity "inventory_transactions" as inventory_transactions {
        * id : UUID <<PK>>
        --
        * spare_part_id : UUID <<FK>>
        * warehouse_id : UUID <<FK>>
        work_order_id : UUID <<FK>>
        * quantity : DECIMAL(12,4)
        * transaction_type : VARCHAR(20)
        * timestamp : TIMESTAMP
        * reason : VARCHAR(255)
        * total_cost : DECIMAL(12,2)
    }

    entity "work_order_spare_parts" as work_order_spare_parts {
        * work_order_id : UUID <<PK, FK>>
        * spare_part_id : UUID <<PK, FK>>
        --
        * planned_quantity : DECIMAL(12,4)
        actual_quantity : DECIMAL(12,4)
    }

    entity "maintainable_item_spare_parts" as maintainable_item_spare_parts {
        * maintainable_item_id : UUID <<PK, FK>>
        * spare_part_id : UUID <<PK, FK>>
        --
    }
}

' Relaciones Segmento B
equipment_units ||--o{ work_requests : "genera"
equipment_units ||--o{ maintenance_plans : "posee"
equipment_units ||--o{ work_orders : "mantenido por"
equipment_units ||--o{ backlog_items : "está listado en"

work_requests |o--o| work_orders : "se convierte en"
maintenance_plans ||--o{ work_orders : "dispara"

work_orders ||--o{ work_order_histories : "registra cambios en (ON DELETE CASCADE)"
work_orders ||--o| failure_records : "reporta"
maintainable_items ||--o{ failure_records : "experimenta"
work_orders ||--o{ media_attachments : "adjunta (ON DELETE CASCADE)"
work_requests ||--o| backlog_items : "prioriza"

' Relaciones Segmento C
suppliers ||--o{ spare_parts : "suministra"
equipment_classes ||--o{ spare_parts : "estandariza"
spare_parts ||--o{ inventory_transactions : "involucrado en"
warehouses ||--o{ inventory_transactions : "almacena"
work_orders ||--o{ inventory_transactions : "genera"

work_orders ||--|{ work_order_spare_parts : "requiere (ON DELETE CASCADE)"
spare_parts ||--|{ work_order_spare_parts : "es consumido en"

maintainable_items ||--|{ maintainable_item_spare_parts : "requiere (ON DELETE CASCADE)"
spare_parts ||--|{ maintainable_item_spare_parts : "es repuesto para"

@enduml
