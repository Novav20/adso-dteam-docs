' Source academic evidence: sena-evidence/01-Analysis/AP2-Conceptual-Model/GA2-220501093/AA2/class-diagram.puml
' Artifact: domain class diagram
' Purpose: Technical PlantUML source extracted from academic evidence for canonical engineering ownership.

@startuml DomainModel
' --- CONFIGURACIÓN VISUAL ---
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

skinparam class {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    BorderThickness 2
    ArrowColor #154360
    AttributeIconSize 0
}

' Estilo del logo "C" (Clase)
skinparam stereotypeCBackgroundColor #AED6F1
skinparam stereotypeCBorderColor #2E86C1

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #AED6F1
    FontStyle bold
}

legend top right
|= Control Documental (ISO 9001:2015) |
| **Código:** DT-DM-UML-001 |
| **Versión:** 1.9 |
| **Fecha:** 2026-06-01 |
| **Estado:** Enriquecimiento DDD de Métodos Completado |
| **Autor:** Juan David Julio Serrano |
endlegend

' --- CAPA 1: FOUNDATION LAYER (ISO 14224) ---
package "Taxonomía de Activos (ISO 14224)" {
    together {
        class FunctionalLocation <<Aggregate Root>> {
            - TagNumber: String
            - Name: String
            - Description: String
            - Criticality: String
            - GeographicLocation: String
            - HierarchyLevel: int
            + AddChild(child: FunctionalLocation): void
            + RemoveChild(childId: UUID): void
            + ReorganizeTree(newParentId: UUID): void
        }

        class EquipmentClass <<Aggregate Root>> {
            - ClassName: String
            - Description: String
            - ManufacturerStandard: String
        }

        class EquipmentUnit <<Aggregate Root>> {
            - SerialNumber: String
            - Manufacturer: String
            - Model: String
            - PurchaseDate: Date
            - RejectionReason: String
            - BoundaryStart: String
            - BoundaryEnd: String
            - AcquisitionDate: Date
            - InstallationDate: Date
            - OperationStartDate: Date
            - OperatingHours: long
            - SurveillanceHours: long
            - OperationalStatus: Enum
            - LifecycleStatus: Enum
            - MaintenanceStatus: Enum
            - HealthStatus: Enum
            - DisposalDate: Date
            - DisposalReason: String
            + Activate(): void
            + RejectCommissioning(reason: String): void
            + DefineBoundaries(start: String, end: String): void
            + UpdateOperationalStatus(status: Enum): void
            + AddSubunit(subunit: Subunit): void
            + Decommission(reason: String, disposalDate: Date): void
        }

        class Subunit <<Entity>> {
            - SubunitType: String
            - Name: String
            + AddMaintainableItem(item: MaintainableItem): void
        }

        class MaintainableItem <<Entity>> {
            - ComponentName: String
            - SubunitType: String
            - SparePartType: String
            - DesignAttributes: String
            - Status: Enum
            + UpdateStatus(newStatus: Enum): void
        }
    }

    FunctionalLocation "1" *-- "0..*" FunctionalLocation : "jerarquía"
    FunctionalLocation "1" o-- "0..1" EquipmentUnit : "instala"
    EquipmentClass "1" -- "0..*" EquipmentUnit : "categoriza"
    EquipmentUnit "1" *-- "1..*" Subunit : "se compone de"
    Subunit "1" *-- "1..*" MaintainableItem : "contiene"
}

' --- CAPA 2: TRANSACTIONAL LAYER (MTTO) ---
package "Operaciones de Mantenimiento (MTTO)" {
    class WorkRequest <<Aggregate Root>> {
        - Description: String
        - Priority: String
        - RequestDate: DateTime
        - RequestSource: String
        - Status: Enum
        - RiskFactor: Enum
        - ImpactFactor: Enum
        - MaintainabilityFactor: Enum
        - EconomyFactor: Enum
        + PromoteToWorkOrder(): void
        + Reject(reason: String): void
        + UpdateRimeFactors(risk: Enum, impact: Enum, maintainability: Enum, economy: Enum): void
    }

    class MaintenancePlan <<Aggregate Root>> {
        - MaintenanceMethod: Enum
        - Frequency: String
        - FrequencyType: Enum
        - NextWorkOrderDate: Date
        - Status: Enum
        + CalculateNextDueDate(lastCompletionDate: DateTime): void
        + GenerateWorkOrder(): WorkOrder
        + Activate(): void
        + Suspend(reason: String): void
        + Archive(): void
    }

    class WorkOrder <<Aggregate Root>> {
        - CurrentStatus: Enum
        - MaintenanceMethod: Enum
        - CreationDate: DateTime
        - ScheduledDate: DateTime
        - ActualStart: DateTime
        - ActualFinish: DateTime
        - ActualLaborHours: Decimal
        - Criticality: Enum
        + Schedule(scheduledDate: DateTime): void
        + RequireIsolation(isolationPointId: UUID): void
        + StartExecution(): void
        + SuspendExecution(reason: String): void
        + CompleteExecution(actualLaborHours: Decimal): void
        + CloseAdministratively(): void
        + ReportFailure(itemId: UUID, mode: Enum, mechanism: Enum, cause: Enum): void
        + AddMediaAttachment(url: String, fileType: Enum): void
    }

    class MediaAttachment <<Value Object>> {
        - FileUrl: String
        - FileType: Enum
        - UploadedAt: DateTime
    }

    class WorkOrderHistory <<Entity>> {
        - OldStatus: Enum
        - NewStatus: Enum
        - Timestamp: DateTime
        - DurationSeconds: long
    }
    ' TODO: Cambiar  mode, mechanism y cause a una clase de valor que permita una taxonomía más rica y flexible, con atributos adicionales como descripción, categoría, etc.
    ' Por ejemplo FailureCatalog
    class FailureRecord <<Entity>> {
        - FailureId: UUID
        - FailureMode: String
        - FailureMechanism: String
        - FailureCause: String
        - Downtime: double
        - Status: Enum
        + UpdateClassification(mode: String, mechanism: String, cause: String): void
    }

    class BacklogItem <<Entity>> {
        - PriorityScore: int
        - Status: Enum
        + UpdatePriorityScore(score: int): void
        + Defer(reason: String): void
    }

    EquipmentUnit "1" -- "0..*" WorkRequest : "genera"
    WorkRequest "0..1" -- "0..1" WorkOrder : "se convierte en"
    EquipmentUnit "1" -- "0..*" MaintenancePlan : "posee"
    EquipmentUnit "1" -- "0..*" WorkOrder : "se ejecuta sobre"
    WorkOrder "1" *-- "0..*" WorkOrderHistory : "registra cambios en"
    WorkOrder "1" -- "0..1" FailureRecord : "reporta"
    MaintenancePlan "1" -- "0..*" WorkOrder : "dispara"
    WorkRequest "1" -- "0..1" BacklogItem : "prioriza"
    MaintainableItem "1" -- "0..*" FailureRecord : "experimenta"
    WorkOrder "1" *-- "0..*" MediaAttachment : "contiene"
}

' --- CAPA 3: RESOURCE LAYER (INV) ---
package "Control de Recursos (INV)" {
    class SparePart <<Aggregate Root>> {
        - Sku: String
        - Description: String
        - Manufacturer: String
        - CommodityCode: String
        - ReorderPoint: int
        - UnitOfMeasure: String
        - StockPolicy: Enum
        - QuantityOnHand: Decimal
        - ReservedQuantity: Decimal
        - MaxCapacity: Decimal
        - UnitCost: Decimal
        - IsRebuildable: Boolean
        - Status: Enum
        + UpdateStockPolicy(policy: Enum, reorder: Decimal, max: Decimal): void
        + ReserveStock(quantity: Decimal): void
        + ReleaseReservation(quantity: Decimal): void
        + ReceiveStock(quantity: Decimal): void
        + IssueStock(quantity: Decimal): void
    }

    class InventoryTransaction <<Entity>> {
        - Quantity: double
        - TransactionType: Enum
        - Timestamp: DateTime
        - Reason: String
        - TotalCost: Decimal
    }

    class MaterialRequirement <<Entity>> {
        - PlannedQuantity: Decimal
        - ActualQuantity: Decimal
        - IsReserved: Boolean
        + MarkAsReserved(): void
        + RecordConsumption(actualQty: Decimal): void
    }

    class Warehouse <<Aggregate Root>> {
        - Name: String
        - Location: String
        - Capacity: double
    }

    class Supplier <<Aggregate Root>> {
        - Name: String
        - ContactInfo: String
        - WarrantyTerms: String
    }

    MaintainableItem "1" -- "0..*" SparePart : "requiere"
    SparePart "1" -- "0..*" InventoryTransaction : "involucrado en"
    Warehouse "1" -- "0..*" InventoryTransaction : "almacena"
    WorkOrder "1" -- "0..*" InventoryTransaction : "genera"
    Supplier "1" -- "0..*" SparePart : "suministra"
    EquipmentClass "1" -- "0..*" SparePart : "estandariza"
    WorkOrder "1" *-- "0..*" MaterialRequirement : "planifica"
    MaterialRequirement "0..*" -- "1" SparePart : "requiere de"
}

' --- CAPA 4: DIGITAL TWIN LAYER (VIS) ---
package "Convergencia Gemelo Digital (VIS)" {
    class MeshMapping <<Entity>> {
        - MeshUuid: String
        - MappingStatus: String
        - LastSyncTime: DateTime
    }

    class TelemetrySignal <<Entity>> {
        - SignalType: String
        - Value: double
        - Unit: String
        - Threshold: double
        - Timestamp: DateTime
        - IsSafetyCritical: Boolean
    }

    class WorkPermit <<Aggregate Root>> {
        - PermitIdentifier: String
        - PermitType: Enum
        - ContractorName: String
        - Status: Enum
        + Approve(): void
        + Revoke(reason: String): void
        + Expire(): void
        + Close(): void
    }

    class IsolationPoint <<Entity>> {
        - IsolationTag: String
        - IsolationType: Enum
        - IsVerified: Boolean
        + MarkAsVerified(): void
    }
    class VisualLayer <<Entity>> {
        - LayerType: String
        - OpacityLevel: double
        - Status: String
    }

    class SpatialMetadata <<Value Object>> {
        - Position: String
        - Rotation: String
        - Scale: String
    }

    EquipmentUnit "1" -- "0..1" MeshMapping : "representado por"
    EquipmentUnit "1" -- "0..*" TelemetrySignal : "monitoreado por"
    MeshMapping "1" -- "1" SpatialMetadata : "ubicado en"
    WorkOrder "1" -- "0..*" VisualLayer : "visualizada en"
    WorkPermit "1" -- "1..*" WorkOrder : "valida ejecución de"
    EquipmentUnit "1" *-- "0..*" IsolationPoint : "contiene"
    WorkOrder "1" -- "1..*" IsolationPoint : "requiere bloqueo de"
}

' --- CAPA 5: GOVERNANCE LAYER (ADM) ---
package "Seguridad y Gobernanza (ADM)" {
    class User <<Aggregate Root>> {
        - Username: String
        - Email: String
        - Status: Enum
        - PasswordHash: String
        - FailedLoginAttempts: int
        - LockoutUntil: DateTime
        - MfaEnabled: Boolean
        - TotpSecret: String
        + AssignRole(roleId: UUID): void
        + RemoveRole(roleId: UUID): void
        + RecordFailedLogin(): void
        + RegisterSuccessfulLogin(): void
        + UpdatePassword(newHash: String): void
        + Deactivate(reason: String): void
        + Activate(): void
    }

    class Role <<Aggregate Root>> {
        - RoleName: String
        - Description: String
        - IsSystemRole: Boolean
        + AddPermission(module: String, action: String): void
        + RemovePermission(module: String, action: String): void
        + ValidateSoD(): void
    }

    class Permission <<Value Object>> {
        - Module: String
        - Action: String
    }

    class AuthToken <<Entity>> {
        - TokenHash: String
        - ExpiresAt: DateTime
        - IsUsed: Boolean
        - IpAddress: String
        - UserAgent: String
        + Revoke(): void
        + MarkAsUsed(): void
    }

    class WorkOrderAssignment <<Entity>> {
        - RoleInWork: Enum
        - AssignedAt: DateTime
    }

    class AuditLog <<Entity>> {
        - EntityType: String
        - ActionType: Enum
        - Timestamp: DateTime
        - IntegrityHash: String
        - EntityIdentifier: String
        - PreviousState: JSON
        - NewState: JSON
        + VerifyIntegrity(): Boolean
    }

    User "1" -- "1..*" Role : "posee"
    Role "1" *-- "0..*" Permission : "concede"
    User "1" *-- "0..*" AuthToken : "posee"
    User "1" -- "0..*" WorkOrderAssignment : "asignado a"
    WorkOrder "1" -- "0..*" WorkOrderAssignment : "requiere de"
    AuditLog "0..*" -- "1" User : "generado por"
}

note bottom of AuditLog : Registro inmutable con hashes
note bottom of FailureRecord : Basado en ISO 14224
note bottom of FunctionalLocation : Solo 1 activo actual por slot
@enduml
