@startuml DT-DM-001-domain-model
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide circle

package "tax" <<Folder>> #E8F4F8 {
    class EquipmentClass {
        + Id: UUID
        + ClassName: String
        + Description: String
        + ManufacturerStandard: String
    }
    class EquipmentUnit {
        + Id: UUID
        + SerialNumber: String
        + Manufacturer: String
        + Model: String
        + PurchaseDate: DateTime
        + RejectionReason: String
        + BoundaryStart: String
        + BoundaryEnd: String
        + AcquisitionDate: DateTime
        + InstallationDate: DateTime?
        + OperationStartDate: DateTime?
        + OperatingHours: Integer
        + SurveillanceHours: Integer
        + DisposalDate: DateTime?
        + DisposalReason: String
        + OperationalStatus: String
        + LifecycleStatus: String
        + MaintenanceStatus: String
        + HealthStatus: String
        + IsSce: Boolean
        + FunctionalLocationId: UUID?
        + EquipmentClassId: UUID
        + WarehouseId: UUID?
        --
        + Activate(): void
        + ValidateChronology(): void
        + DefineBoundaries(boundaryStart: String, boundaryEnd: String): void
        + UpdateOperationalStatus(newStatus: Enum): void
        + AddSubunit(subunit: Subunit): void
        + Decommission(reason: String, disposalDate: Date): void
        + RejectCommissioning(reason: String): void
        + TransitionToStorage(warehouseId: UUID): void
        + TransitionToRepair(): void
    }
    class FunctionalLocation {
        + Id: UUID
        + TagNumber: String
        + Name: String
        + Description: String
        + Criticality: String
        + GeographicLocation: String
        + EnvironmentalExposure: String
        + HierarchyLevel: Integer
        + ParentId: UUID?
        --
        + AddChild(child: FunctionalLocation): void
        + RemoveChild(childId: UUID): void
        + ReorganizeTree(newParentId: UUID): void
        + InstallEquipment(equipment: EquipmentUnit): void
        + UninstallEquipment(): EquipmentUnit
    }
    class MaintainableItem {
        + Id: UUID
        + SubunitId: UUID
        + ComponentName: String
        + SubunitType: String
        + SparePartType: String
        + DesignAttributes: JSON
        + Status: String
        --
        + UpdateStatus(newStatus: Enum): void
    }
    class Subunit {
        + Id: UUID
        + EquipmentUnitId: UUID
        + SubunitType: String
        + Name: String
        --
        + AddMaintainableItem(item: MaintainableItem): void
    }
}

package "mtto" <<Folder>> #FFF0E6 {
    class BacklogItem {
        + Id: UUID
        + EquipmentUnitId: UUID
        + WorkRequestId: UUID
        + PriorityScore: Integer
        + Status: String
        --
        + UpdatePriorityScore(score: int): void
        + Defer(reason: String): void
    }
    class FailureRecord {
        + Id: UUID
        + WorkOrderId: UUID
        + MaintainableItemId: UUID?
        + FailureMode: String
        + FailureMechanism: String
        + FailureCause: String
        + DetectionMethod: String
        + OperationalCondition: String
        + OperationalImpact: String
        + Downtime: Decimal
        + Status: String
        --
        + UpdateClassification(mode: Enum, mechanism: Enum, cause: Enum): void
    }
    class MaintenancePlan {
        + Id: UUID
        + EquipmentUnitId: UUID
        + MaintenanceMethod: String
        + Frequency: String
        + FrequencyType: String
        + NextWorkOrderDate: DateTime?
        + IntervalValue: Decimal?
        + NextTriggerLimit: Decimal?
        + EstimatedLaborHours: Decimal
        + RequiredSpecialty: String
        + TechnicalDescription: String
        + Status: String
        --
        + CalculateNextDueDate(lastCompletionDate: DateTime): void
        + GenerateWorkOrder(): WorkOrder
        + Activate(): void
        + Suspend(reason: String): void
        + Archive(): void
        + CalculateNextTriggerLimit(currentUsage: Decimal): void
    }
    class MediaAttachment {
        + Id: UUID
        + WorkOrderId: UUID
        + FileUrl: String
        + FileType: String
        + UploadedAt: DateTime
    }
    class WorkOrderHistory {
        + Id: UUID
        + WorkOrderId: UUID
        + OldStatus: String
        + NewStatus: String
        + Timestamp: DateTime
        + DurationSeconds: Integer?
    }
    class WorkOrder {
        + Id: UUID
        + EquipmentUnitId: UUID
        + MaintenancePlanId: UUID?
        + WorkRequestId: UUID?
        + WorkPermitId: UUID?
        + CurrentStatus: String
        + MaintenanceMethod: String
        + CreationDate: DateTime
        + ScheduledDate: DateTime?
        + ActualStart: DateTime?
        + ActualFinish: DateTime?
        + ActualLaborHours: Decimal?
        + Criticality: String
        --
        + Schedule(scheduledDate: DateTime): void
        + RequireIsolation(isolationPointId: UUID): void
        + StartExecution(): void
        + CompleteExecution(actualLaborHours: Decimal): void
        + CloseAdministratively(): void
        + ReportFailure(maintainableItemId: UUID, mode: Enum, mechanism: Enum, cause: Enum, detectionMethod: Enum, operationalCondition: Enum, operationalImpact: Enum): void
        + AddMediaAttachment(fileUrl: String, fileType: Enum): void
        + SuspendExecution(reason: String): void
    }
    class WorkRequest {
        + Id: UUID
        + EquipmentUnitId: UUID
        + Description: String
        + Priority: String
        + RequestDate: DateTime
        + RequestSource: String
        + Status: String
        + WorkClassCode: Integer
        --
        + PromoteToWorkOrder(): void
        + Reject(reason: String): void
        + UpdateWorkClass(workClass: int): void
    }
}

package "inv" <<Folder>> #E6F4EA {
    class InventoryTransaction {
        + Id: UUID
        + SparePartId: UUID
        + WarehouseId: UUID
        + WorkOrderId: UUID?
        + Quantity: Decimal
        + TransactionType: String
        + Timestamp: DateTime
        + Reason: String
        + TotalCost: Decimal
        + AisleShelfLocation: String
        + SerialNumber: String
    }
    class MaintainableItemSparePart {
        + MaintainableItemId: UUID
        + SparePartId: UUID
    }
    class MaterialRequirement {
        + WorkOrderId: UUID
        + SparePartId: UUID
        + PlannedQuantity: Decimal
        + ActualQuantity: Decimal?
        + IsReserved: Boolean
        --
        + MarkAsReserved(): void
        + RecordConsumption(actualQuantity: Decimal): void
    }
    class SparePart {
        + Id: UUID
        + Sku: String
        + Description: String
        + Manufacturer: String
        + CommodityCode: String
        + ReorderPoint: Decimal
        + UnitOfMeasure: String
        + StockPolicy: String
        + IsRebuildable: Boolean
        + QuantityOnHand: Decimal
        + ReservedQuantity: Decimal
        + MaxCapacity: Decimal
        + UnitCost: Decimal
        + Status: String
        + SupplierId: UUID
        + EquipmentClassId: UUID?
        --
        + UpdateStockPolicy(policy: Enum, reorderPoint: Decimal, maxCapacity: Decimal): void
        + ReserveStock(quantity: Decimal): void
        + ReleaseReservation(quantity: Decimal): void
        + ReceiveStock(quantity: Decimal): void
        + IssueStock(quantity: Decimal): void
    }
    class Supplier {
        + Id: UUID
        + Name: String
        + ContactInfo: String
        + WarrantyTerms: String
    }
    class Warehouse {
        + Id: UUID
        + Name: String
        + Location: String
        + Capacity: Decimal
    }
}

package "vis" <<Folder>> #F3E5F5 {
    class IsolationPoint {
        + Id: UUID
        + EquipmentUnitId: UUID
        + IsolationTag: String
        + IsolationType: String
        + IsVerified: Boolean
        --
        + MarkAsVerified(): void
    }
    class MeshMapping {
        + Id: UUID
        + EquipmentUnitId: UUID
        + MeshUuid: String
        + MappingStatus: String
        + LastSyncTime: DateTime?
    }
    class SpatialMetadata {
        + MeshMappingId: UUID
        + Position: JSON
        + Rotation: JSON
        + Scale: JSON
    }
    class TelemetrySignal {
        + Id: UUID
        + EquipmentUnitId: UUID
        + SignalType: String
        + Value: Decimal
        + Unit: String
        + Threshold: Decimal?
        + Timestamp: DateTime
        + IsSafetyCritical: Boolean
    }
    class VisualLayer {
        + Id: UUID
        + WorkOrderId: UUID
        + LayerType: String
        + OpacityLevel: Decimal
        + Status: String
    }
    class WorkOrderIsolation {
        + WorkOrderId: UUID
        + IsolationPointId: UUID
        + IsIsolated: Boolean
        + IsolatedAt: DateTime?
        + PadlockTagId: String
    }
    class WorkPermit {
        + Id: UUID
        + EquipmentUnitId: UUID
        + PermitIdentifier: String
        + PermitType: String
        + ContractorName: String
        + Status: String
        --
        + Approve(): void
        + Revoke(reason: String): void
        + Expire(): void
        + Close(): void
    }
}

package "adm" <<Folder>> #FFF3CD {
    class AuditLog {
        + Id: UUID
        + UserId: UUID?
        + EntityType: String
        + EntityIdentifier: String
        + ActionType: String
        + Timestamp: DateTime
        + PreviousState: JSON
        + NewState: JSON
        + IntegrityHash: String
        --
        + VerifyIntegrity(): boolean
    }
    class AuthToken {
        + Id: UUID
        + UserId: UUID
        + TokenHash: String
        + ExpiresAt: DateTime
        + IsUsed: Boolean
        + IpAddress: String
        + UserAgent: String
        --
        + Revoke(): void
        + MarkAsUsed(): void
    }
    class RolePermission {
        + Id: UUID
        + RoleId: UUID
        + Module: String
        + Action: String
    }
    class Role {
        + Id: UUID
        + RoleName: String
        + Description: String
        + IsSystemRole: Boolean
        --
        + AddPermission(module: String, action: String): void
        + RemovePermission(module: String, action: String): void
        + ValidateSoD(): void
    }
    class UserRole {
        + UserId: UUID
        + RoleId: UUID
    }
    class User {
        + Id: UUID
        + Username: String
        + FullName: String
        + Email: String
        + Status: String
        + PasswordHash: String
        + FailedLoginAttempts: Integer
        + LockoutUntil: DateTime?
        + MfaEnabled: Boolean
        + TotpSecret: String
        + DeactivationReason: String
        --
        + AssignRole(roleId: UUID): void
        + RemoveRole(roleId: UUID): void
        + RecordFailedLogin(): void
        + RegisterSuccessfulLogin(): void
        + UpdatePassword(newPasswordHash: String): void
        + Deactivate(reason: String): void
        + Activate(): void
    }
    class WorkOrderAssignment {
        + Id: UUID
        + WorkOrderId: UUID
        + UserId: UUID
        + RoleInWork: String
        + AssignedAt: DateTime
    }
}

' Relationships
FunctionalLocation "1" --> "0..N" FunctionalLocation : contiene jerárquicamente a
FunctionalLocation "1" --> "0..1" EquipmentUnit : instala
EquipmentClass "1" --> "0..N" EquipmentUnit : categoriza
EquipmentUnit "1" *-- "1..N" Subunit : se compone de
Subunit "1" *-- "1..N" MaintainableItem : contiene
EquipmentUnit "1" --> "0..N" WorkRequest : genera
EquipmentUnit "1" --> "0..N" MaintenancePlan : posee
EquipmentUnit "1" --> "0..N" WorkOrder : mantenido por
EquipmentUnit "1" --> "0..N" BacklogItem : está listado en
WorkRequest "0..1" --> "0..1" WorkOrder : se convierte en
MaintenancePlan "1" --> "0..N" WorkOrder : dispara
WorkOrder "1" *-- "0..N" WorkOrderHistory : registra cambios en
WorkOrder "1" --> "0..1" FailureRecord : reporta
MaintainableItem "1" --> "0..N" FailureRecord : experimenta
WorkOrder "1" *-- "0..N" MediaAttachment : adjunta
WorkRequest "1" --> "0..1" BacklogItem : prioriza
Supplier "1" --> "0..N" SparePart : suministra
EquipmentClass "1" --> "0..N" SparePart : estandariza
SparePart "1" --> "0..N" InventoryTransaction : involucrado en
Warehouse "1" --> "0..N" InventoryTransaction : almacena
Warehouse "1" o-- "0..N" EquipmentUnit : resguarda en stock
WorkOrder "1" --> "0..N" InventoryTransaction : genera
WorkOrder "1" *-- "1..N" MaterialRequirement : planifica
SparePart "1" --> "1..N" MaterialRequirement : es consumido en
MaintainableItem "1" *-- "1..N" MaintainableItemSparePart : requiere
SparePart "1" --> "1..N" MaintainableItemSparePart : es repuesto para
EquipmentUnit "1" --> "0..1" MeshMapping : representado por
MeshMapping "1" *-- "1" SpatialMetadata : ubicado en
EquipmentUnit "1" --> "0..N" TelemetrySignal : monitoreado por
EquipmentUnit "1" --> "0..N" WorkPermit : autoriza intervención en
EquipmentUnit "1" --> "0..N" IsolationPoint : contiene
WorkPermit "1" --> "0..N" WorkOrder : valida ejecución de
WorkOrder "1" *-- "0..N" VisualLayer : visualizada en
WorkOrder "1" *-- "1..N" WorkOrderIsolation : requiere
IsolationPoint "1" --> "1..N" WorkOrderIsolation : bloqueado por
User "1" *-- "1..N" UserRole : asociado a
Role "1" *-- "1..N" UserRole : concedido a
Role "1" *-- "0..N" RolePermission : contiene
User "1" *-- "0..N" AuthToken : autenticado con
User "1" *-- "0..N" WorkOrderAssignment : se le asigna
WorkOrder "1" *-- "0..N" WorkOrderAssignment : asigna personal
User "1" o-- "0..N" AuditLog : genera

@enduml