@startuml "Diagrama de Despliegue del Gemelo Digital EAM"
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

skinparam node {
    BackgroundColor #F8F9F9
    BorderColor #2E86C1
    BorderThickness 2
}
skinparam database {
    BackgroundColor #FDEDEC
    BorderColor #E74C3C
}
skinparam cloud {
    BackgroundColor #EBF5FB
    BorderColor #3498DB
}

legend top right
|= Control Documental (ISO 9001:2015) |
| **Código:** DT-ARQ-DEP-001 |
| **Versión:** 1.4 |
| **Fecha:** 2026-07-14 |
| **Estado:** Vigente |
| **Autor:** Juan David Julio Serrano |
endlegend

node "Dispositivo Móvil (Edge Node)\n[Android / iOS]" as MobileNode {
    component "Frontend App\n(React Native)" as App
    component "LOTO Watchdog\n(Background Thread)" as Watchdog
    database "Local DB\n(SQLite / WatermelonDB)" as LocalDB

    App -down-> LocalDB : "Persiste Estado"
    Watchdog -left-> LocalDB : "Bloqueo Preventivo\nsi falla Heartbeat"
}

node "Estación de Control Local (Edge)\n[SCADA]" as ScadaNode {
    component "SCADA Engine\n(Instrument/Sensor Emulator)" as ScadaApp
}

node "Estación de Trabajo / Oficina HSEQ\n[PC de Escritorio]" as WebNode {
    component "Web Admin Portal\n(React SPA)" as WebApp
}

cloud "Azure Cloud Platform" as Azure {
    node "Azure IoT Hub" as IoTHub
}

node "Servidor Cloud Host\n[Nube / VPS Estudiante]" as HostNode {
    note top of HostNode
        Hospedado con créditos de estudiante
        (GitHub Student Pack / Heroku / Azure VM)
    end note
    node "Docker Engine" as Docker {
        component "Nginx\n(Reverse Proxy & Statics Server)" as Proxy
        component "Backend API Monolith\n(.NET 10)" as Backend
        Proxy -down-> Backend : "Enrutamiento"
    }
}

node "Servidor de Base de Datos" as DBServer {
    note top of DBServer
        Postgres administrado o contenedor
        vía créditos GitHub Student Pack
    end note
    database "PostgreSQL 16 +\nTimescaleDB Extension" as RDBMS
}

' Conexiones de Red
MobileNode .up.> Proxy : "HTTPS / JSON\n(Sincronización API)"
MobileNode .right.> Proxy : "WSS (SignalR)\n[Heartbeat Bidireccional 2s]"
WebNode .down.> Proxy : "HTTP/GET (Descarga de estáticos React)"
WebNode .down.> Proxy : "HTTPS / JSON (Peticiones API)"
WebNode .down.> Proxy : "WSS (SignalR) [Dashboard KPIs]"
ScadaNode .right.> IoTHub : "MQTT\n(Telemetría de proceso real)"

Backend -down-> RDBMS : "TCP/IP (EF Core)"
Backend -right-> IoTHub : "AMQP (Consumo)"

note left of Watchdog
    **Capa Administrativa de Seguridad:**
    Tolerancia a ruido EMI industrial.
    Si fallan 3 ciclos de Heartbeat
    (6 segundos), el Watchdog
    bloquea localmente la App.
end note
@enduml