@startuml ComponentModel
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

skinparam component {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    BorderThickness 2
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #AED6F1
    FontStyle bold
}
skinparam databaseBackgroundColor #FDEDEC
skinparam cloudBackgroundColor #EBF5FB

legend top right
|= Control Documental (ISO 9001:2015) |
| **Código:** DT-ARQ-CMP-001 |
| **Versión:** 1.2 |
| **Fecha:** 2026-06-11 |
| **Estado:** Auditoría en Progreso |
| **Autor:** Juan David Julio Serrano |
endlegend

package "Frontend Application (HPHMI)" {
    component "Mobile Client\n<<React Native / SQLite>>" as Mobile
    component "Web Admin Portal\n<<React>>" as Web
}

package "Backend: Modular Monolith" {

    package "Infrastructure Layer (Adapters)" {
        component "Idempotency Filter\n<<Memory Cache / Redis>>" as Idempotency
        component "REST API Controllers\n<<ASP.NET Core / C#>>" as API
        component "Real-Time Broadcaster\n<<SignalR / WebSockets>>" as WS
        component "Background Sync Worker\n<<.NET Hosted Service>>" as Sync
        component "Persistence Adapter\n<<EF Core / PostgreSQL>>" as DBAdapter
        component "Telemetry Ingestion Adapter\n<<Azure IoT SDK>>" as IoTAdapter

        Idempotency -down-> API : "Filtra Reintentos"
    }

    package "Core Application & Domain Layer" {
        interface "Primary Ports (In)" as InPorts
        interface "Secondary Ports (Out)" as OutPorts

        component "Taxonomy Kernel" as Tax
        component "Maintenance" as Mtto
        component "Inventory" as Inv
        component "Digital Twin" as Vis
        component "Governance & Audit" as Adm

        InPorts -down-> Tax
        InPorts -down-> Mtto
        InPorts -down-> Inv
        InPorts -down-> Vis
        InPorts -down-> Adm
    }
}

database "PostgreSQL & TimescaleDB" as DB
cloud "Azure IoT Hub\n(Free Tier)" as IoT

' Conexiones de Entrada (Driving Adapters)
Web .down.> Idempotency : "HTTPS / JSON"
Mobile .down.> Idempotency : "HTTPS (Sync)"
Mobile .down.> WS : "WSS (Real-Time)"

API -down-> InPorts : "Invoca"
WS -down-> InPorts : "Invoca"
Sync -down-> InPorts : "Procesa Colas"
IoTAdapter -up-> InPorts : "Ingesta Telemetría"

' Conexiones de Salida (Driven Adapters)
Tax -down-> OutPorts
Mtto -down-> OutPorts
Inv -down-> OutPorts
Vis -down-> OutPorts
Adm -down-> OutPorts

OutPorts -down-> DBAdapter : "Implementa"
OutPorts -down-> IoTAdapter : "Implementa"
OutPorts -up-> WS : "Implementa"

DBAdapter .down.> DB : "TCP/IP (SQL)"
IoTAdapter .down.> IoT : "MQTT / AMQP"

note right of InPorts
    **Regla de Dependencia Estricta:**
    El Núcleo (Casos de Uso) orquesta la telemetría.
    Los adaptadores externos implementan las interfaces
    de salida (OutPorts) para desacoplar la tecnología.
end note
@enduml