@startuml ComponentModel
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam componentStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

skinparam component {
    BackgroundColor #EBF5FB
    BorderColor #2E86C1
    BorderThickness 2
}
skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #AED6F1
    FontStyle bold
}
skinparam databaseBackgroundColor #FDEDEC
skinparam cloudBackgroundColor #EBF5FB

legend top right
|= Control Documental (ISO 9001:2015) |
| **Código:** DT-ARQ-CMP-001 |
| **Versión:** 1.0 |
| **Fecha:** 2026-06-10 |
| **Estado:** En Desarrollo |
| **Autor:** Juan David Julio Serrano |
endlegend

package "Frontend Application (React / React Native)" {
    component "Mobile App (Offline-First)" as Mobile
    component "Web Admin Portal" as Web
}

package "Backend: Modular Monolith (.NET 10)" {
    
    package "Infrastructure Layer (Adapters)" {
        component "REST API Controllers" as API
        component "WebSocket / SignalR Hub" as WS
        component "Background Sync Worker" as Sync
        component "EF Core Postgres Adapter" as DBAdapter
        component "Azure IoT Hub Adapter" as IoTAdapter
    }

    package "Core Domain Layer (Ports & Use Cases)" {
        interface "Primary Ports (In)" as InPorts
        interface "Secondary Ports (Out)" as OutPorts
        
        component "Taxonomy Kernel (ISO 14224)" as Tax
        component "Maintenance (MTTO)" as Mtto
        component "Inventory (INV)" as Inv
        component "Digital Twin (VIS)" as Vis
        component "Governance & Audit (ADM)" as Adm
    }
}

database "PostgreSQL & TimescaleDB" as DB
cloud "Azure IoT Hub\n(Free Tier)" as IoT

' Conexiones de Entrada (Driving Adapters)
Web .down.> API : "HTTPS/JSON"
Mobile .down.> API : "HTTPS (Sync)"
Mobile .down.> WS : "WSS (Real-Time)"

API -down-> InPorts : "Invoca"
WS -down-> InPorts : "Invoca"
Sync -down-> InPorts : "Procesa Colas"

InPorts -down-> Tax
InPorts -down-> Mtto
InPorts -down-> Inv
InPorts -down-> Vis
InPorts -down-> Adm

' Conexiones de Salida (Driven Adapters)
Tax -down-> OutPorts
Mtto -down-> OutPorts
Inv -down-> OutPorts
Vis -down-> OutPorts
Adm -down-> OutPorts

OutPorts -down-> DBAdapter : "Implementa"
OutPorts -down-> IoTAdapter : "Implementa"

DBAdapter .down.> DB : "TCP/IP (SQL)"
IoTAdapter .down.> IoT : "MQTT/AMQP"
IoTAdapter .up.> WS : "Emite Eventos"

note right of InPorts
  **Regla de Dependencia:**
  El Dominio ignora la existencia
  de bases de datos o redes.
  Todo se invoca mediante interfaces.
end note
@enduml